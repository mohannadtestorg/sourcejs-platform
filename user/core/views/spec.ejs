<!DOCTYPE html>
<!--[if IE 7]>
<html class="ie7"> <![endif]-->
<!--[if IE 8]>
<html class="ie8"> <![endif]-->
<!--[if IE 9]>
<html class="ie9"> <![endif]-->
<!--[if gt IE 9]><!-->
<html lang="en"> <!--<![endif]-->
<head>
    <meta charset="UTF-8">
    <title><%= info.title %></title>
    <meta name="author" content="<%= info.author %>">
    <% if (info.keywords !== '') { %>
    <meta name="keywords" content="<%= info.keywords %>">
    <% } %>

    <!-- DO NOT ADD MASTER APP STYLES HERE, WE ARE LINKING CSS AND JS TO SPEC USING "SPECS/TEMPLATES" -->

    <!-- Source default resources -->
    <link href="/source/assets/css/source.css" rel="stylesheet" data-source="core">
    <script src="/source/assets/js/require.bundle.js" data-source="core"></script>
    <script src="/source/assets/js/enter-the-source.js" data-source="core"></script>
    <!-- /Source default resources -->

    <%- head %>
    <% if (info && info.authEnabled === true) { %>
    <script>
        var auth = {
            isAtyponEmployee: <%- info.isAtyponEmployee ? JSON.stringify(info.isAtyponEmployee) : 'false' %>,
            prods: <%- info.userProds ? JSON.stringify(info.userProds) : 'false' %>
        }
    </script>
    <% } %>
</head>
<body class="source_page __spec <%- info.loggedIn ? 'logged_in' : 'logged_out' %>">
<div class="source_container">
    <%- header %>
    <div class="source_main source_col-main" role="main"><%- content %></div>
    <%- footer %>
</div>
</body>
</html>

