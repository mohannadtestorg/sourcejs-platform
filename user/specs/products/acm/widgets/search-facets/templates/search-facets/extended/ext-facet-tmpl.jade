extends ../../../../../../../ux3/widgets/search-facets/templates/search-facets/extended/ext-facet-tmpl

block facetTitle
    a(href="#" title=data.title aria-controls="titleFacet" class="facet__ctrl accordion__control")
        h4.facet__title !{data.title}
        i(aria-hidden="true" class="icon-section_arrow_d")

block facetMain
    if data.title || data.values
        div.facet.accordion
            if (data) && (data.title)
                +facetTitle()
            if (data) && (data.values)
                div.facet__content.accordion__content(id="facet")
                    +facetUl(data)