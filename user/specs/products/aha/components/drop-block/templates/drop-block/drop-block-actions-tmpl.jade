-var id= data.id


.dropBlock.dropBlock--actions
    a(href="#", data-db-target-for="#{id}").btn--actions
    .dropBlock__holder(data-db-target-of="#{id}")
        ul.rlist.inline-icon
            if data.actions
                each action, r in data.actions
                       li
                            a.btn--action(class=action.class href= action.link ? action.link : "#")
                               if(action.icon)
                                  i(class=action.icon)
                               span !{action.label}
