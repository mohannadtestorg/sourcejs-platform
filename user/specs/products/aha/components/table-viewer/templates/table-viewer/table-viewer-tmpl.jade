div#table-viewer.table-viewer(data-ux3-wrapper="table-viewer",data-ux3-transformed-by="tableInit", data-ux3-role="parent", role="dialog")
    .table-viewer__reg__top.clearfix
        .table-viewer__top__right
            span.table-viewer__ctrl
                a.table-viewer__ctrl__close(title="Close Tables Viewer", href="#" , data-ux3-role="controller" )
                    span.icon-close_thin
            span.table-viewer__ctrl
                a.table-viewer__ctrl__browse(title="Browse All Tabless", href="#" )
                    span.icon-allfigures
                a.table-viewer__ctrl__return.is-hidden(title="Return to Tables", href="#" )
                    span.icon-arrow-right
            span.table-viewer__ctrl
                a.table-viewer__ctrl__prev(title="Previous Tables", href="#" )
                        span.icon-arrow_l
                a.table-viewer__ctrl__next(title="Next Tables", href="#" )
                    span.icon-arrow_r

        .table-viewer__top__left
            span.table-viewer__ctrl
                span.table-viewer__title__text Title
            span.table-viewer__ctrl
                span.tblZoomSlider.js__zoom-slider.ui-slider(tabindex="1")
                    input.zoom-range(type="range")
                button.table-viewer__label__zoom.icon-zoom.zoom-in(title='zoom in')
                button.table-viewer__label__zoom.icon-zoom-out.zoom-out.hidden(title='zoom out')
            span.table-viewer__ctrl
                a.table-viewer__ctrl__caption(title="Open/Close Caption", href="#")
                    span.icon-doublearrow
                    span.table-viewer__caption__label Caption
    .table-viewer__caption_area
        a.table-viewer__ctrl__caption.reversed(title="Open/Close Caption", href="#")
            span.icon-doublearrow
        div.table-viewer__hold__tblcap
    .table-viewer__reg__center
        .table-viewer__cent__left
            .table-viewer__hold__tbl
                div.holder
            .table-viewer__hold__list.clearfix.container
