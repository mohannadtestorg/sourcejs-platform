if (data.widget && data.widget.slides)
    div.viewport-slider(data-slider-vport="screen-xs")
        .slideShow
            div.owl-carousel(data-items=1 data-responsive=responsive data-speed=speed data-autoplay=autoplay data-animation=animation data-indicators=indicators data-arrow=arrow data-controls=controls)
                each item, k in data.widget.slides
                    block slideShowDropZone
                        | !{item}

