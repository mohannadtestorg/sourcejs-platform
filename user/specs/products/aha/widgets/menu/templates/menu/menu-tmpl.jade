- var dropDownId = 0;

- var side_content = false;

- var viewPort = "";
- var viewPortClass = "";
-
    if (thisWidget.properties && thisWidget.properties.vPort){
    if (thisWidget.properties.vPort == "XSmall") {
    viewPort = "screen-xs";
    viewPortClass = 'hidden-xs';
    viewPortInvertClass = 'hidden-md hidden-sm hidden-lg';
    } else if (thisWidget.properties.vPort == "small") {
    viewPort = "screen-sm";
    viewPortClass = 'hidden-sm hidden-xs';
    viewPortInvertClass = 'hidden-md hidden-lg';
    } else if (thisWidget.properties.vPort == "medium") {
    viewPort = "screen-md";
    viewPortClass = 'hidden-md hidden-sm hidden-xs';
    viewPortInvertClass = 'hidden-lg';
    } else {
    viewPort = "never";
    viewPortClass = '';
    viewPortInvertClass = 'hidden-md hidden-sm hidden-xs hidden-lg';
    }
    };

mixin link(item)
    if ( item.list)
        - dropDownId = dropDownId + 1;
    block menuDropdown
        if (item.link) && (item.list)
            a.dropdown__toggle(href=item.link title=item.text id=data.id + "-" + dropDownId data-toggle="dropdown")
                if (item.text)
                    span !{item.text}
                block mainNavArrows
                    i.icon-arrow_r.pull-right(aria-hidden="true" class=viewPortInvertClass)
                    i.icon-section_arrow_d.pull-right(aria-hidden="true" class=viewPortClass)
            +menu(item.list, true)
        else if (item.link)
            block MenuItemLink
                a(href=item.link title=item.text target=item.target)
                    if (item.text)
                        span !{item.text}
                    if (item.target) && item.target === "_blank"
                        | &nbsp;
                        i.icon-download-sitation(aria-hidden="true")
        else if (item.list)
            a.dropdown__toggle(href="#" title=item.text id=data.id + "-" + dropDownId data-toggle="dropdown" target=item.target)
                if (item.text)
                    span !{item.text}
                i.icon-arrow_r.pull-right(aria-hidden="true" class=viewPortInvertClass)
                i.icon-section_arrow_d.pull-right(aria-hidden="true" class=viewPortClass)
            +menu(item.list, true)
        else
            if (item.text)
                span !{item.text}


mixin menuItem(list, nested)
    each item, i in list

        -var liClass = "menu-item ";
        if ( item.list)
            //- dropDownId = dropDownId + 1;
            - liClass = "dropdown menu-parent";
        if item.current == "true"
            - liClass = liClass + " is--current";

        if (item.className)
            - liClass = liClass + " " + item.className;

        if (item.side_content)
            - side_content = item.side_content;

        if (item.list)
            if nested
                li(class=liClass role="menuitem" aria-haspopup="true" tabindex="-1" aria-label=item.text )
                    +link(item)
            else
                li(class=liClass role="menuitem" aria-haspopup="true"  aria-label=item.text id='menu-item-' + data.id + '-' + i)
                    +link(item)
        else
            if nested
                li(class=liClass role="menuitem" tabindex="-1" aria-label=item.text )
                    if item.content
                        | !{item.content}
                    else
                        +link(item)
            else
                li(class=liClass role="menuitem" aria-label=item.text id='menu-item-' + data.id + '-' + i)
                    +link(item)




mixin menu(list, nested)
    //p !{JSON.stringify(list[3])}
    if nested == true
        div(class="dropdown__menu " + (side_content ? "has_side_content" : "") aria-labelledby=data.id + "-" + dropDownId class="level-" + dropDownId aria-hidden="true" role="menu")
            ul.rlist
                - dropDownId = 0;
                +menuItem(list, nested)
            if side_content
                div.menu__side__content
                    block menuSideContent
                        | !{side_content}
                      //  | !{pb.renderDropzone(thisWidget, "menuDropzone")}
                    - side_content = false;
    else
        ul#menubar.rlist--inline(role="menubar")
            +menuItem(list, nested)
            block menuSuffix


block mainNavBlock
    div.main-nav
        a(href="#" + data.id data-target=data.id data-toggle="nav" title="menu drawer")
            block navIcons
                i.icon-menu2(aria-hidden="true")
                i.icon-close_thin(aria-hidden="true")
        nav.drawer__nav.container.gutterless(role="navigation" id=data.id class=viewPortClass data-ctrl-res=viewPort)
            a.menu-header(href='#' class=viewPortInvertClass) Home
            +menu(data.list, false)

block MenuDropZone
    .header__dropzone

        | !{pb.renderDropzone(thisWidget, "menuDropzone")}


