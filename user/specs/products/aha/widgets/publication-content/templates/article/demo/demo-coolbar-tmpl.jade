.stickybar.coolBar.article-sections
  ul.rlist.coolBar__first.hidden-lg(data-cb-group="Article" data-cb-group-icon="icon-toc")
    li
      a.coolBar__ctrl(href="#")
        i(class="icon-abstract" aria-hidden="true")
        span About
    li.coolBar--sections.scroll-to-target
      a.coolBar__ctrl(href="#" data-db-target-for="sections" )
        i(class="icon-sections" aria-hidden="true")
        span Sections
      div.coolBar__drop.rlist(data-db-target-of="sections" id="sectionMenu")
  ul.rlist.coolBar__first(data-cb-group="Article" data-cb-group-icon="icon-toc")
      li.float-right-xs
        a.coolBar__ctrl(href="#" data-db-target-for="tools" data-db-switch="icon-close_thin")
          i.icon-Icon_Tools(aria-hidden="true")
          span.hidden-xs.hidden-sm Tools
        ul.coolBar__drop.fixed.rlist(data-db-target-of="tools")
          li
            a(href="#")
              i.icon-export_citation(aria-hidden="true")
              span Export Citation
          li
            a(href="#")
              i.icon-favorites(aria-hidden="true")
              span Add to Favorites
          li
            a(href="#")
              i.icon-Email(aria-hidden="true")
              span Email a Friend
          li
            a(href="#")
              i.icon-track(aria-hidden="true")
              span Track Citations
          li
            a(href="#")
              i.icon-permissions(aria-hidden="true")
              span Permissions
      li.float-right-xs
        a.coolBar__ctrl(href="#" data-db-target-for="share" data-db-switch="icon-close_thin")
          i.icon-Icon_Share(aria-hidden="true")
          span.hidden-xs.hidden-sm Share
        ul.coolBar__drop.fixed.rlist(data-db-target-of="share")
          li
            a(href="#")
              i.icon-facebook(aria-hidden="true")
              span Facebook
          li
            a(href="#")
              i.icon-twitter(aria-hidden="true")
              span Twitter
          li
            a(href="#")
              i.icon-linkedin(aria-hidden="true")
              span LinkedIn
          li
            a(href="#")
              i.icon-google-plus(aria-hidden="true")
              span Google+
          li
            a(href="#")
              i.icon-share(aria-hidden="true")
              span Reddit
          li
            a(href="#")
              i.icon-share(aria-hidden="true")
              span CiteULike


    #sections.hidden.visible-lg
      h2.toc__heading.section__header Jump to
      ul.sections__drop.rlist
