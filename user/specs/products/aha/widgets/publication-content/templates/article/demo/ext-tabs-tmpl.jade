extends ../extended/ext-tabs-tmpl

block tabsPrefix
    - var original = data;
    - var fakeId = "pcw";
    - var config = {"type":"flex","effect": "slide","vPort":"xsmall"};
    - var tabsData = {"nav":[{"text": "Figures","icon": "icon-Icon_Images","content": "","class": "figures" , "content" : data.item.figures },{"text": "References","icon": "icon-Icon_Links-References","content": "","class": "references" , "content" : data.item.references},{"text": "Related","icon": "icon-related2","class": "related","content": ""},{"text": "Details","icon": "icon-Icon_Information","class": "details","content": data.item.coverImage , "content2": data.topContent}]};
    - data = tabsData;

block detailsTab
    include ./details-tab-tmpl.jade

block tabsMain
    div.tab.tab--slide.tab--flex.sticko__md.tabs--xs.dynamic-sticko(class=classNames)
        ul.rlist.tab__nav.w-slide--list(data-mobile-toggle = "slide")
            +nav()
        +pane()
