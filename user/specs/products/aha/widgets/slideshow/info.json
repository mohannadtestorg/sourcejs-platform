                                        "has-covers"
                                    ]
                                },
                                "data": {
                                    "content": {
                                        "$pug": {
                                            "template": "./templates/demo/slideshow-covers-tmpl.jade",
                                            "data": {
                                                "$ref": "./templates/data/slideshow-covers.json"
                                            }
                                        }
                                    }

                                }
                            }

