extends ./slideshow-tmpl

block slideShow
    .row.has-image.has-thumbnails-viewer
        .col-xs-12.col-md-8
            .slideShow
                div.owl-carousel(data-items=items data-responsive=responsive data-speed=speed data-autoplay=autoplay data-animation=animation data-indicators=indicators data-arrow=arrow data-controls=controls)
                    each item, k in data.widget.slides
                        block slideShowDropZone
                            div.slide-item
                                | !{pb.renderDropzone(thisWidget, item)}
        .hidden.visible-md.visible-lg.col-md-4
            .slider-thumbnail-viewer
