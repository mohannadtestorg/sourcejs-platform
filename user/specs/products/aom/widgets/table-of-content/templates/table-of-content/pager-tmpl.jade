block topPager
    - var counter = 0
    - var newurl = ""

- var  temp = data.url

mixin pageItem(i, pages)
    - var pageId = i;

    block pagerNumbers
        if( i > 0)
            if data && i >= data.pageStart - 1 && i <= data.pageStart + 5
                - counter = counter + 1;
                li
                    if  i == data.pageStart
                        - newurl = pb.updateParam(temp,"pageStart",pageId)
                        - newurl = pb.updateParam(newurl,"pageSize",data.pageSize)
                        a.active(href= newurl, title=i) !{i}
                    else
                        - newurl = pb.updateParam(temp,"pageStart",pageId)
                        - newurl = pb.updateParam(newurl,"pageSize",data.pageSize)
                        a(href= newurl, title=i) !{i}
            else if data && data.pageStart >= 0 && data.pageStart < 5 && i >= 6 && i < 8
                - counter = counter + 1;
                li
                    - newurl = pb.updateParam(temp,"pageStart",pageId)
                    - newurl = pb.updateParam(newurl,"pageSize",data.pageSize)
                    a(href= newurl, title=i) !{i}
        if i < pages && counter < 7
            +callBack(i + 1, pages)

mixin callBack(j,pages)
    +pageItem(j, pages)


.pagination
    -pages=data.numberOfPages | 0
    - var nextPageId = data.pageStart +1;
    - var prevPageId = data.pageStart -1;
    if prevPageId >= 1
        block previousPage
            span
                - var prevPageId = data.pageStart -1;
                - newurl = pb.updateParam(temp,"pageStart",prevPageId)
                a.pagination__btn--prev(href= newurl, title='Previous Page')
    if(pages >1)
        ul.rlist--inline.pagination__list
            - var i = 1
            +pageItem( data.pageStart - 2, pages )
    if nextPageId < pages
        block nextPage
            span
                - var nextPageId = data.pageStart +1;
                - newurl = pb.updateParam(temp,"pageStart",nextPageId)
                a.pagination__btn--next(href= newurl, title='Next page')