extends /specs/products/app/page-structure/structure/templates/structure/layout-tmpl.jade



block content

    h1 Books Homepage
    .source_info


    section.source_section
        h2 Books Homepage
        markdown
        .source_example
            | !{data.header}
            main.pol-theme.content
                .container.books-homepage
                    .col-lg-9.col-md-8
                        h5.font-weight-light.border-bottom FEATURED BOOKS
                        .books-main-slider.slider__container.responsiveSlider3-1-1
                          | !{data.MainSlides}


                        h5.font-weight-light.border-bottom
                           span DSM Library
                           a(href="#" title="see all").link.text-between-arc see all
                        .slider__container.border.responsiveSlider4-3-1.move-slider-by-page
                          | !{data.Slides}




                        h5.font-weight-light.border-bottom
                            span BOOKS
                            a(href="#" title="see all").link.text-between-arc see all
                        .slider__container.border.responsiveSlider4-3-1
                            | !{data.Slides}



                    .col-lg-3.col-md-4
                        h5.font-weight-light.border-bottom BOOK OF THE MONTH
                        .book-of-month.two-column
                           | !{data.BookofMonth}

                        .newsletter__wrapper
                            h5.font-weight-light.section__header.border-bottom newsletter
                            |  !{data.nl}


                        .advertisement.center
                            a(href="#" title="adv")
                                img(src="/specs/products/app/widgets/publication-content/images/articleAdv.jpg")






            | !{data.footer}
    | #{''}