                                each facet, l in data.facet
                                    | !{facet}
                        .col-sm-8.col-lg-9
                            h5.font-weight-light.border-bottom.hidden-sm.hidden-xs  BOOKS
                            | !{data.searchresult}



            | !{data.footer}
    | #{''}
