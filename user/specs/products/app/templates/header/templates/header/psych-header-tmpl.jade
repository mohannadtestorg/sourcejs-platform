-var headerClasses= "";
-var fixedClass="fixed";
if(loiHeader)
    -headerClasses="header-loi-exists activate-res";

if(!journalHeader)
    -headerClasses= "header-small";


if(advertisementHeader)
    -fixedClass=""
    .header__advertisement
        .container
            | !{advertisementHeader}

header.header.base(data-db-parent-of="sb1" class=headerClasses + " " +fixedClass)
    .header--first-row.responsive-menu-holder
        .pull-left
            | !{logo}
        .drawer__nav
            | !{mainmenu}
        .pull-right
            .institution-wrapper
                | !{institution}
            .header__quick-menu
                .header__login
                    | !{user}
                .header__search
                    | !{search}
                .header__advanced-search.hidden-xs
                    a(href="#") Advanced Search

    | !{journalHeader}
    if(loiHeader)
        div(class="#{themeClass}")
            .header__coolBar
                | !{loiHeader}
    if(headerBottomNav)
        div(class="#{themeClass}")
            .header-bottom-nav
                .container.responsive-menu-holder
                    .drawer__nav
                        | !{headerBottomNav}
