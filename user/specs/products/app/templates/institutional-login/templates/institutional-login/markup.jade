section.shibboleth
    .institutions
        h3.page__header
            | Select your institution
        h5 FEDERATION
        .tab.tab--res(data-ctrl-res='screen-xlg')
            .dropBlock(data-db-parent-of='dbTab-1')
                a(href='#', data-db-target-for='dbTab-1')
                    span
                        | OpenAthens Federation
                    i.icon-arrow_d_n.pull-right(aria-hidden='true')
                ul.rlist.tab__nav(role='tablist', data-mobile-toggle='dropdown', data-db-target-of='dbTab-1', style='top: 43px; left: 0px; width: 1080px;')
                    li(role='presentation')
                        a#pane-federation-con-0(href='#pane-federation-0', aria-controls='#pane-federation-0', role='tab', data-toggle='tab', title='Academic Access Management Federation in Japan (GakuNin)', aria-selected='false', aria-expanded='false')
                            span Academic Access Management Federation in Japan (GakuNin)
                    li(role='presentation')
                        a#pane-federation-con-1(href='#pane-federation-1', aria-controls='#pane-federation-1', role='tab', data-toggle='tab', title='Japan - GakuNin', aria-selected='false')
                            span Japan - GakuNin
                    li.active(role='presentation')
                        a#pane-federation-con-2(href='#pane-federation-2', aria-controls='#pane-federation-2', role='tab', data-toggle='tab', title='OpenAthens Federation', aria-selected='false', aria-expanded='true')
                            span OpenAthens Federation
                    li(role='presentation')
                        a#pane-federation-con-3(href='#pane-federation-3', aria-controls='#pane-federation-3', role='tab', data-toggle='tab', title='UK Higher Education', aria-selected='false')
                            span UK Higher Education
            ul.rlist.tab__content
                li#pane-federation-0.tab__pane(aria-labelledby='pane-federation-con-0', role='tabpanel')
                    h5 SELECT YOUR INSTITUTE
                    ul
                        li(data-value='GakuNin IdP')
