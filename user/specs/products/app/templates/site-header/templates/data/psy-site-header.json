{
    "siteLogo": {
        "$pug": {
            "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
            "data": {
                "model": {
                    "config": {
                        "wrapper": "true",
                        "className": ["site-header__logo hidden-sm hidden-xs"]
                    },
                    "data": {
