extends /specs/products/app/page-structure/structure/templates/structure/layout-tmpl.jade


block content

    section.source_section
        include /specs/page-structure/helpers/print-json-mixin.jade
        include /specs/page-structure/helpers/print-js-code-mixin.jade

        h2 Usage
        h3 Include template
        +printJsCode('include /specs/ux3/widgets/pairing-management/templates/pairing-management/pairing-management-tmpl.jade')
        h3 Data
        p The following data structure must exist to be able to use pairing management template.

        +printJson(
        {
            "data": {
                "hiddenData": {
                    "serviceName": "showInstitutionDevicePairingManagement",
                    "antiForgeryToken": "4d9f7a27-f0a6-4a4c-b217-8d30bf6daf53",
                    "institutionUserId": "2922"
                },
                "pairingDuration": 180
            }
        }
        )


    | #{''}

    section.source_section
        h2 Example

        each item, l in data.items
            h3!= item.title

            .source_example
                div.container.pol-theme
                    | !{item.body}


    | #{''}