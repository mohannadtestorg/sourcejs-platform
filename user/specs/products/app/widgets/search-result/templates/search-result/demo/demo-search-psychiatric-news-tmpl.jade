extends ../search-result-psych-tmpl


block searchResultMain
    .psych-search-item
        .psych-search-item__image
            a(href="#" title="Digital Advertising Is Effective Tool for Engaging People on Early Psychosis")
                img(src="http://placehold.it/107x72" title="Digital Advertising Is Effective Tool for Engaging People on Early Psychosis")

        .psych-search-item__info
            time.psych-search-item__date  September 01, 2017
            a(href="#" title="Digital Advertising Is Effective Tool for Engaging People on Early Psychosis")
                h2.psych-search-item__title  Digital Advertising Is Effective Tool for Engaging People on Early Psychosis
            p.psych-search-item__summary.hidden-xs  A search engine–based advertising campaign targeting people who may be experiencing early psychosis symptoms proved effective at bringing users to a website where they could obtain more information about the disorder.
