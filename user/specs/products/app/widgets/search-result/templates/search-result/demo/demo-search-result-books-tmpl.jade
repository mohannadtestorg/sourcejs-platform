extends ../search-result-tmpl


block searchResultMain
    ul.rlist.search-result__body(class=searchlistClass)
        li.clearfix.separator.search__item
            .item__image
                a(href='/link/to/journal', title='go to Future Science OA')
                    img(src='http://placehold.it/185x276', title='cover Image of Future Science OA')
            .item__body
                .meta__header
                    span.meta__type Books
                    span.meta__access
                        i.icon-lock_open
                        span Full Access
                h4.meta__title
                    a(href='http://ux3-prod.literatumonline.com/doi/10.4155/fsoa-2016-0031e1') Achieving service oriented architecture
                .meta__info
                    .meta__book-authors
                        span by:
                        ul.meta__authors.rlist--inline.comma(title='list of authors')
                            li
                                a(href='#') Peter Schrenk

                    .meta__isbn
                         span ISBN/EAN:
                         span.gray 97835254545
                    .meta__first-published
                          span First Published:
                          span.gray 23/5/2014
                    .meta__details.no-bottom-space
                        span Edition:
                          span.gray  4th
                        span  Pages:
                          span.gray 480
                    .meta__keywords
                        span.keywords-label Topics:
                        ul.rlist--inline.comma.keywords-list(title='list of keywords')

                            li
                                a(href='#').keyword-title Architecture
                            li
                                a(href='#').keyword-title Psychology
                            li
                                a(href='#').keyword-title Service
                    .accordion.book-search-abstract
                        a.accordion__control(href='#', title='show Abstract', aria-expanded='false')
                            span Abstract
                            i.icon-section_arrow_d(aria-hidden='true')
                        .accordion__content(style='display: none;')
                            | An age-structured life-cycle model of steelhead (Oncorhynchus mykiss) for the Stillaguamisharr numbers by the estimated area of steelhead rearing habitat
                    .meta__available
                             span Also available in: 
