header(class="header fixed base #{code}" data-db-parent-of="sb1")
    .container.header--first-row
        .pull-left
            | !{logo}
            | !{journalLogo}
        .pull-right
            .institution-wrapper
                | !{institution}
            .header__quick-menu
                ul.rlist--inline
                    li
                        | !{search}
                    li
                        | !{cart}
                    li
                        | !{user}
    .text-onDark.drawer__nav
        .container
            .row
                .col-xs-12
                    | !{mainmenu}