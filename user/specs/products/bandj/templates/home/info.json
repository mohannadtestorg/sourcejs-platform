{
    "title": "Home page",
    "tag": ["templates"],
    "templateData": {
        "header":{
            "$pug": {
                "template": "../header/templates/header/header-tmpl.jade",
                "data": {
                    "$ref": "../header/templates/data/header.json"
                }
            }
        },
        "slider":{
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "true",
                            "className": ["card card--extra-gutter card--shadow left-side-image slideshow-wrapper"]
                        },
                        "data": {
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/widgets/slideshow/templates/slideshow/demo/slideshow-demo-tmpl.jade",
                                    "data": {
                                        "$ref": "./templates/data/cards.json"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "articles":{
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "true",
                            "className": ["grid-sm-2"],
                            "headingLevel": "h3",
                            "headingClass": ["section__header border-bottom"]
                        },
                        "data": {
                            "title": "LATEST ARTICLES",
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/widgets/top-content/templates/top-content/top-content-tmpl.jade",
                                    "data": {
                                        "$ref": "../../../../ux3/templates/home/templates/data/most-x-grid.json"
                                    }
                                }
                            }
                        }
                    }

                }
            }
        },
        "nl": {
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "true",
                            "className": [
                                "card--dark",
                                "card--gutter"
                            ]
                        },
                        "data": {
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/components/newsletter/templates/newsletter/newsletter-tmpl.jade",
                                    "data": {
                                        "$ref": "../../../../ux3/components/newsletter/templates/data/newsletter.json"
                                    }
                                }
                            }
                        }
                    }

                }
            }
        },
        "news":{
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "true",
                            "className": ["grid-sm-2 grid-lg-2 featured"],
                            "headingLevel": "h3",
                            "headingClass": ["section__header border-bottom"]
                        },
                        "data": {
                            "title": "News",
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/widgets/top-content/templates/top-content/top-content-tmpl.jade",
                                    "data": {
                                        "$ref": "../../../../ux3/templates/home/templates/data/most-x-featured.json"
                                    }
                                }
                            }
                        }
                    }
                }
            }

        },
        "tweets":{
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "false",
                            "headingLevel": "h3",
                            "headingClass": ["section__header border-bottom"]
                        },
                        "data": {
                            "title": "Twitter",
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/components/tweets/templates/tweets/tweets-tmpl.jade",
                                    "data": {
                                        "body": [
                                            {
                                                "screenName": "TwitterDev",
                                                "theme": "dark",
                                                "height": "800"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "issues":{
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "true",
                            "className": ["grid-sm-5 grid-xs-margin--extra"],
                            "headingLevel": "h3",
                            "headingClass": ["section__header border-bottom"]

                        },
                        "data": {
                            "title": "JOURNAL LATEST ISSUES",
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/widgets/cover-image/templates/cover-image/cover-image-tmpl.jade",
                                    "data": {
                                        "$ref": "../../../../ux3/templates/home/templates/data/cover.json"
                                    }
                                }
                            }
                        }
                    }
                }
            }

        },
        "footer":{
            "$pug": {
                "template": "../../../../ux3/templates/footer/templates/footer/footer-tmpl.jade",
                "data": {
                    "$ref": "../footer/templates/data/footer.json"
                }
            }
        }
    }
}

