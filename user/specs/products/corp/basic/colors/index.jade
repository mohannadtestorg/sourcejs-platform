        h2 Supporting Colors
        .source_example.colors-palette
            ul.rlist--inline.text-colors
                li
                    div.atypon-blue-light.block
                    p #e1e9f0
                li
                    div.atypon-blue-lightest.block
                    p #f5f7fa
                li
                    div.atypon-red-light.block
                    p #fde5e4
                li
                    div.atypon-red-lightest.block
                    p #fefef6
                li
                    div.atypon-green.block
                    p #33976a
                li
                    div.atypon-green-light.block
                    p #e1f0e9


    | #{''}
    .source_section
        h2 Text Colors
        .source_example.colors-palette
            ul.rlist--inline.border-colors
                li
                    div.primary-text-color.block Aa
                    p $primary-text-color
                li
                    div.secondary-text-color.block Aa
                    p $secondary-text-color
                li
                    div.tertiary-text-color.block Aa
                    p $tertiary-text-color
    | #{''}

