    //    h2 Basic color pallete
    //    p we are including #[a(href="/specs/ux3/basic/colors/") UX3 color pallete ]

    .source_section
        h2 Colors
        .source_example.colors-palette
            ul.rlist--inline.bg-colors
                li
                    div.atypon-blue.block
                    p #336d96
                li
                    div.atypon-red.block
                    p #f04e49
                li
                    div.atypon-gray-dark.block
                    p #3f4359
                li
                    div.atypon-gray.block
                    p #6f7283
                li
                    div.atypon-gray-light.block
                    p #9f9fa5
                li
                    div.atypon-gray-lightest.block
                    p #f4f4f4

    | #{''}
