extends /specs/products/corp/page-structure/structure/templates/structure/layout-tmpl.jade

block cssLastInHead
    include /specs/products/corp/page-structure/structure/templates/structure/css-lastin-head-tmpl.jade
    link(rel='stylesheet', href='/specs/ux3/basic/icon-fonts/scss/helpers/icons.css')

block content
    include /specs/page-structure/helpers/print-html-code-mixin.jade

    section.source_section
        h2 Usage
        p We are using #[a(href="https://icomoon.io/") IcoMoon] font to render icons in our templates (<code>specs/fonts</code>).
        p Use <code>i</code> tag with icon class name to add an icon in your code. here you can find complete list of icons for reference.
        h3 Example
        +printHtmlCode('<i class="icon-facebook" aria-hidden="true"></i>')
    | #{''}

    section.source_section
