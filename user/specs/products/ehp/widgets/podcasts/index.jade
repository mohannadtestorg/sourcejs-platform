extends /specs/products/ehp/page-structure/structure/templates/structure/layout-tmpl.jade

include ../../../../ux3/page-structure/structure/templates/structure/helpers/print-json-mixin.jade
include ../../../../ux3/page-structure/structure/templates/structure/helpers/print-js-code-mixin.jade

block content

    section.source_section
        h2 Podcasts item

        h3 Usage

        markdown.
            - widget name: `podcasts`

        h3 Data

        .source_info
            p Not ready, static data presented in widget template

        h3 Example

        .source_example
            div.container
                | !{pb.render('podcasts', 'podcasts.json')}

    section.source_section
        h2 Podcasts list

        h3 Usage

        markdown.
            - widget name: `podcasts`
            - alternative template: `podcasts-list`

        h3 Data

        +printJson({
            "data": {
                "items": [
                    {
                        "contentType": "Podcast",
                        "title": "An Unlikely Duo: Air Pollution’s Link to Low Birth Weight, with Tracey Woodruff",
                        "best": "/doi/full/10.1061/%28ASCE%29CP.1943-5487.0000527",
                        "host": "Jon Doe",
                        "length": "15:35",
                        "epubDate": "13 JUL 2017",
                        "doi": "http://doi.org/10.1002/iid3.98",
                        "pdf": "#?pdf"
                    },
                    {
                        "contentType": "Podcast",
                        "title": "The Secret Life of Fat, with Michele La Merrill",
                        "best": "/doi/full/10.1061/%28ASCE%29CP.1943-5487.0000527",
                        "host": "Jon Doe",
                        "length": "15:35",
                        "epubDate": "13 JUL 2017",
                        "doi": "http://doi.org/10.1002/iid3.98",
                        "pdf": "#?pdf"
                    }
                ]
            }
        })

        h3 Example

        .source_example
            div.container
                | !{pb.render('podcasts', 'podcasts-list', 'podcasts.json')}

    | #{''}
