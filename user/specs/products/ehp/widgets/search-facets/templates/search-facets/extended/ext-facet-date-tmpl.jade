extends ../../../../../../../ux3/widgets/search-facets/templates/search-facets/extended/ext-facet-date-tmpl

block dateFacetTitle
    a(href="#" title=data.title aria-controls="dateFacet" class="facet__ctrl accordion__control js--open")
        h4.facet__title !{data.title}
        i(aria-hidden="true" class="icon-section_arrow_d")


block facetSliderDates
    span.pull-left
        span From:
        input.index-1.range-slider__start(value=data.values.minDate size=4)
    span.pull-right
        span To:
        input.index-2.range-slider__end(value=data.values.maxDate size=4)