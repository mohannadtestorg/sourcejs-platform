block searchResultMain
    ul.rlist.search-result__body.titles-results
        li.clearfix.separator.search__item
            .item__body
                .meta__header
                    span.meta__type Article
                    span.meta__access
                        i.icon-lock_open
                        span Open Access
                h5.meta__title.meta__title__margin
                    a(href='/link/to/journal') Well-known protein stimulates insulin secretion in pancreatic cells
                .meta__info
                    ul.meta__authors.rlist--inline.comma(title='list of authors')
                        li
                            a(href='#') Peter Schrenk
                        li
                            a(href='#') Henry Smith
