extends /specs/products/esspp/page-structure/structure/templates/structure/layout-tmpl.jade

block content

    section.source_section
        h2 Badge variations

        h3 Type badge
        markdown
            p In the example below we have added `badge-type` to the link item.
        .source_example
            span.badge-type(href='#') Type

        h3 OA badge
        markdown
            p In the example below we have added `badge-oa` to the link item.
        .source_example
            span.badge-oa(href='#') Open Access

        h3 Free badge
        markdown
            p In the example below we have added `badge-fa` to the link item.
        .source_example
            span.badge-fa(href='#') Free

        h3 CME badge
        markdown
            p In the example below we have added `badge-cme` to the link item.
        .source_example
            span.badge-cme(href='#') CME
    | #{''}

    section.source_section
        h2 State Badges

        h3 Review
        markdown
            p `badge-state badge-state--review`
        .source_example
            span(title="Review").badge-state.badge-state--review

        h3 Saved
        markdown
            p `badge-state badge-state--saved`
        .source_example
            span(title="Saved").badge-state.badge-state--saved

        h3 Rejected
        markdown
            p `badge-state badge-state--rejected`
        .source_example
            span(title="Rejected").badge-state.badge-state--rejected

        h3 Cancelled
        markdown
            p `badge-state badge-state--cancelled`
        .source_example
            span(title="Cancelled").badge-state.badge-state--cancelled

        h3 Draft
        markdown
            p `badge-state badge-state--draft`
        .source_example
            span(title="Draft").badge-state.badge-state--draft

        h3 Processing
            markdown
                p `badge-state badge-state--processing`
            .source_example
                span(title="Approved").badge-state.badge-state--processing

        h3 Approved
        markdown
            p `badge-state badge-state--approved`
        .source_example
            span(title="Approved").badge-state.badge-state--approved



    | #{''}
