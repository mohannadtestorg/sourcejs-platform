extends /specs/products/esspp/page-structure/structure/templates/structure/layout-tmpl.jade

block content

    section.source_section
        h2 Buttons variations

        h3 Default with hover and focus effects button
        markdown
            p In the example below we have added `btn` to the button item.
        .source_example
            button.btn I am button

        h3 Disabled button
        markdown
            p In the example below we have added `disabled` attribute to make the button disabled.
        .source_example
            button.btn(disabled="disabled") I am button

        h3 Full-width button
        markdown
            p In the example below we have added `btn` and `btn--full-width` to the button item to be fluid width.
        .source_example
            button.btn.btn--full-width I am full-width button

        h3 Submit button
        markdown
            p In the example below we have added `submit` btn--inverse to the button item.
        .source_example
            button.btn--inverse I am button

        h3 Cancel button
        markdown
            p In the example below we have added `btn--cancel` class to the button item.
        .source_example
            button.btn--cancel I am button

        h3 Gray button
        markdown
            p In the example below we have added `btn--gray` class to the button item.
        .source_example
            button.btn--gray I am button

        h3 link
        markdown
            p In the example below we have added `link` class to the link.
        .source_example
            a.link Link

        h3 Standard button with standard color
        markdown
            p In the example below we have added `btn--standard` class to the link.
        .source_example
            button.btn--standard Standard Button


    | #{''}

    section.source_section
        h2 Special Buttons

        h3 Reject Button
        markdown
            p In the example below we have added `btn--reject` to the button item.
        .source_example
            button.btn--reject Reject
        markdown
            p In the example below we have added `btn--reject--inverse` to the button item.
        .source_example
            button.btn--reject--inverse Reject Article

        h3 Approval Button
        markdown
            p In the example below we have added `btn--approval` to the button item.
        .source_example
            button.btn--approval Approve
        markdown
            p In the example below we have added `btn--approval--inverse` to the button item.
        .source_example
            button.btn--approval--inverse Approve Article