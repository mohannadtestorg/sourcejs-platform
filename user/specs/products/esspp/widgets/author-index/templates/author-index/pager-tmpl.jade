- var counter = 0
- var originURL = ""
- var newurl = ""
- var sign = "?"

mixin removeParam(key, sourceURL)
    - var rtn = sourceURL.split("?")[0]
    - var params_arr = []
    - var queryString = (sourceURL.indexOf("?") !== -1) ? sourceURL.split("?")[1] : ""
    - newurl = originURL
    - sign = "?"
    if queryString !== ""
        -    params_arr = queryString.split("&");
        -    for (var i = params_arr.length - 1; i >= 0; i -= 1) {
        -        param = params_arr[i].split("=")[0];
        -        if (param === key) {
        -            params_arr.splice(i, 1);
        -        }
        -    }
        -    rtn = rtn + "?" + params_arr.join("&");
        -    newurl = rtn
        - sign = "&"
            
if (data.http && data.http.requestUri)
    - originURL = data.http.requestUri ? data.http.requestUri : ""


mixin pageItem(i, pages)
    - var pageId = i - 1;

    block pagerNumbers
        if( i > 0)
            if data.search && i >= data.search.startPage - 1 && i <= data.search.startPage + 3
                - counter = counter + 1;
                li
                    if  i == data.search.startPage + 1
                        +removeParam("startPage",originURL)
                        a.active(href= newurl + sign + "startPage=" + pageId, title=i) !{i}
                    else
                        +removeParam("startPage",originURL)
                        a(href= newurl + sign + "startPage=" + pageId, title=i) !{i}
            else if data.search && data.search.startPage >= 0 && data.search.startPage < 3 && i >= 4 && i < 6
                - counter = counter + 1;
                li
                    +removeParam("startPage",originURL)
                    a(href= newurl + sign + "startPage=" + pageId, title=i) !{i}
        if i < pages && counter < 5
            +callBack(i+1, pages)

mixin callBack(j,pages)
    +pageItem(j, pages)

.pagination
    -pages=pages | 0
    - var nextPageId = data.search.startPage +1;
    - var prevPageId = data.search.startPage -1;
    if prevPageId >= 0
        span
            - var prevPageId = data.search.startPage -1;
            +removeParam("startPage",originURL)
            a.pagination__btn--prev(href= newurl + sign + "startPage=" + prevPageId, title='Previous Page')
    if(pages >1)
        ul.rlist--inline.pagination__list
            - var i = 1
            +removeParam("startPage",originURL)
            +pageItem( data.search.startPage - 2, pages )
    if nextPageId < pages
        span
            - var nextPageId = data.search.startPage +1;
            +removeParam("startPage",originURL)
            a.pagination__btn--next(href= newurl + sign + "startPage=" + nextPageId, title='Next page')