extends /specs/products/esspp/page-structure/structure/templates/structure/layout-tmpl.jade


block content
    include /specs/page-structure/helpers/print-json-mixin.jade
    include /specs/page-structure/helpers/print-js-code-mixin.jade

    section.source_section
        h2 Usage
        h3 Data
        markdown
            p The following data structure must exist to be able to use funders widget.

        +printJson({
            "data": {
                "forms": [
                    {
                        "grant-number": {
                            "value": "DE-6734-48855",
                            "message": {}
                        },
                        "recepient": {
                            "value": "Jet Propulsion",
                            "message": {}
                        },
                        "funder": {
                            "value": [
                                "Department of Energy",
                                "Secretary"
                            ]
                        }
                    },
                    {
                        "grant-number": {
                            "value": "DE-6734-000566",
                            "message": {}
                        },
                        "recepient": {
                            "value": "Institue of Systems Engineering",
                            "message": {}
                        },
                        "funder": {
                            "value": [
                                "Secretary of Defense"
                            ]
                        }
                    }
                ],
                "funderSearchLink": "#"
            }
        })

    | #{''}

    section.source_section
        h2 Examples

        h3!= data.items[0].title
        .source_example
            | !{data.items[0].body}

        h3!= data.items[1].title
        .source_example
            | !{data.items[1].body}


    | #{''}