                                                "render": "html",
                                                "html": "<div class=\"card card--gutter card--shadow meta__body\"><div class=\"meta__left-side left-side-image\"><img alt=\"cover\" src=\"http://ux3-proto.literatumonline.com/resources/cms/settings/fum/publications/fca/cover.png\" class=\"meta__img\"><h1 class=\"meta__title\">Journal of Aerospace Engineering</h1><div class=\"meta__info\"><p>ISSN (print): 0893-1321 | ISSN (online): 1943-5525</p><p>Frequency: Bimonthly | Sponsored by the Aerospace Division</p></div><p class=\"meta__contrib\"><span class=\"meta__contrib__label\">Editor:</span> Wieslaw Binienda, Ph.D., F.ASCE, University of Akron</p></div><div class=\"meta__right-side\"><a href\"#=\"href\" #\"=\"\" class=\"btn btn--inverse btn--journal-meta\">Submit an article</a><a href\"#=\"href\" #\"=\"\"class=\"btn btn--inverse btn--journal-meta\">Subscribe</a></div></div>"
                                            }
