extends /specs/products/faseb/page-structure/structure/templates/structure/layout-tmpl.jade



block content

    h1 Search Result page
    section.source_section
        h2 Search Result page
        markdown
        code.src-html
        .source_example
            div.hide-menu-dropzone-xs
                | !{data.header}
            main.content
                .quickSearchRegion.dark
                    .container
                        .row
                            div.col-lg-12.clearfix
                                | !{data.quickSearch}

                .container
                    .row
                        .col-sm-5.col-md-4.col-lg-3
                            #filter.hidden-xs.hidden-sm.search__filters
                                each facet, l in data.facet
                                    | !{facet}
                        .col-sm-7.col-md-8.col-lg-9
                            | !{data.searchresult}



            | !{data.footer}
    | #{''}