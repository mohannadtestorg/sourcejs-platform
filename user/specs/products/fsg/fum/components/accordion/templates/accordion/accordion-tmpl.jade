block accordionPrefix

mixin link(item, i)
    block accordionLink
        if (item.url)
            a.accordion-tabbed__control.external(href=item.url title=item.label aria-expanded="false" aria-controls=thisWidget.id + i)
                | !{item.label}
        else
            a.accordion-tabbed__control(href="#" title=item.label aria-expanded="false" aria-controls=thisWidget.id + i)
                | !{item.label}

mixin accordion()
    block accordionMain
        div.accordion
            block accordionType
                if thisWidget.properties.type == 'tabbed' && (data.items)
                    block tabbed
                        ul.accordion-tabbed.rlist
                            each item, i in data.items
                                if (item.class)
                                    li.accordion-tabbed__tab(class= item.class)
                                        +link(item, i)
                                        if !(item.url)
                                            .accordion-tabbed__content(id= thisWidget.id + i)
                                                block accordionDropZone
                                                    | !{pb.renderDropzone(thisWidget, "accordionDropZone_" + thisWidget.id + i)}
                                else
                                    li.accordion-tabbed__tab
                                        +link(item, i)
                                        if !(item.url)
                                            .accordion-tabbed__content(id= thisWidget.id + i)
                                                block accordionDropZone
                                                    | !{pb.renderDropzone(thisWidget, "accordionDropZone_" + thisWidget.id + i)}

                else if thisWidget.properties.type == 'single' && (data.items)
                    each item, i in data.items
                        a.accordion__control(href="#" title=item.label aria-expanded="false" aria-controls=thisWidget.id + i)
                            span !{item.label}
                            i.icon-section_arrow_d(aria-hidden="true")
                        .accordion__content(id= thisWidget.id + i)
                            | !{item.content}

                else if thisWidget.properties.type == 'subSection' && (data.items)
                    each item, i in data.items
                        a.accordion__control.sub(href="#" title=item.label aria-expanded="false" aria-controls=thisWidget.id + i)
                            i.icon-section_arrow_d(aria-hidden="true")
                            span !{item.label}
                        .accordion__content.bordered(id= thisWidget.id + i)
                            | !{item.content}


block accordion
    +accordion()

block accordionSuffix