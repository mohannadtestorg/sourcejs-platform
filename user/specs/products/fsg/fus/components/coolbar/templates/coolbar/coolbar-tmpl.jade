block coolbarPrefix

nav.stickybar.coolBar.trans
    div.stickybar__wrapper.coolBar__wrapper.clearfix
        div.rlist.coolBar__zone
            block coolbarDropZone
                div.coolBar__section
                    | pb.renderDropzone(thisWidget, 'coolbarDropZone1')
        ul.rlist.coolBar__first(data-cb-group="Article" data-cb-group-icon="icon-toc")
            block CoolbarSections
            block coolbarDownloads
            block coolbarFull

        ul.coolBar__second.rlist
            block coolBarSecond
                | !{pb.renderDropzone(thisWidget, "coolbarDropZone")}
block coolbarSuffix
