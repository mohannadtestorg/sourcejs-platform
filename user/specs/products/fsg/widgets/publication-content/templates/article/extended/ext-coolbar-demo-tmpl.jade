extends ../../../../../../../ux3/widgets/publication-content/templates/article/extended/ext-coolbar-demo-tmpl.jade

block coolbarPrefix
    - var original = data;
    - var coolbarData = {"sections": {"icon": "icon-Icon_Section-menu","label": "Sections"},"download": {"icon": "icon-download","label": "View Article","items": [{"icon": "icon-Icon_Download","text": "View PDF","url": data.item.formats.pdf},{"icon": "icon-Icon_Download","text": "View PDFPlus","url": data.item.formats.pdfPlus},{"icon": "icon-Icon_Download","text": "View ePub","url": data.item.formats.ePub},{"icon": "icon-Icon_Download","text": "View AM PDF","url": data.item.formats.amPdf}]},"extra": [{"content": "<a href=\"#\" data-db-target-for=\"tools\" data-db-switch=\"icon-close_thin\" class=\"coolBar__ctrl\"><i aria-hidden=\"true\" class=\"icon-tools\"></i><span>Tools</span></a><ul data-db-target-of=\"tools\" class=\"coolBar__drop fixed rlist\"><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-export_citation\"></i><span>Export Citation</span></a></li><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-favorites\"></i><span>Add to Favorites</span></a></li><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-Email\"></i><span>Email a Friend</span></a></li><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-track\"></i><span>Track Citations</span></a></li><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-permissions\"></i><span>Permissions</span></a></li></ul>"},{"content": "<a href=\"#\" data-db-target-for=\"share\" data-db-switch=\"icon-close_thin\" class=\"coolBar__ctrl\"><i aria-hidden=\"true\" class=\"icon-share\"></i><span>Share</span></a><ul data-db-target-of=\"share\" class=\"coolBar__drop fixed rlist\"><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-facebook\"></i><span>Facebook</span></a></li><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-twitter\"></i><span>Twitter</span></a></li><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-linkedin\"></i><span>LinkedIn</span></a></li><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-google-plus\"></i><span>Google+</span></a></li><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-share\"></i><span>Reddit</span></a></li><li><a href=\"#\"><i aria-hidden=\"true\" class=\"icon-share\"></i><span>CiteULike</span></a></li></ul>"}]};
    - data  = coolbarData;


block coolbarDropZone
    div.coolBar__section
    a.coolBar__ctrl.hidden-lg.w-slide__btn(href="#" data-db-target-for="article" data-db-switch="icon-close_thin"  data-slide-target="#articleMenu")
        i(class="icon-Icon_About-Article" aria-hidden="true")
        span About
    div.coolBar__drop.fixed.rlist(data-db-target-of="article" id="articleMenu")
        block coolbarDropZoneTransplant
            div.transplant.showit(data-target="article .tab .tab__nav, .coolBar--download .coolBar__drop" data-remove="false" data-target-class="hidden-xs hidden-sm hidden-md" data-toggle="transplant" data-direction="from" data-transplant="self")


block downloadCoolbarSection
    li.coolBar__section.coolBar--download.hidden-xs.hidden-sm.hidden-md
        if(data.download && data.download.label)
          a.coolBar__ctrl(href="#" data-db-target-for="downloads" data-db-switch="icon-close_thin")
            i(class= data.download.icon aria-hidden="true")
            span !{data.download.label}
        ul.coolBar__drop.rlist.w-slide--list(data-db-target-of="downloads")
            if(data.download && data.download.items)
              each item, i in data.download.items
                if(item.url)
                    li
                        a(href= item.url)
                            i(class= item.icon aria-hidden="true")
                            span !{item.text}