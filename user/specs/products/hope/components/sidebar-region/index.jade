extends /specs/products/hope/page-structure/structure/templates/structure/layout-tmpl.jade


block content

    section.source_section
        include /specs/page-structure/helpers/print-json-mixin.jade
        include /specs/page-structure/helpers/print-js-code-mixin.jade

        h2 Usage
        h3 Include template
        +printJsCode('include /specs/ux3/components/sidebar-region/templates/sidebar-region/sidebar-region-tmpl.jade')
        h3 Data


        +printJson({
            "type": "ContribStored",
            "title": "Content Type",
            "more": 11,
            "values": [
                {
                    "label": "Blog",
                    "link": "#",
                    "count": 10
                },
                {
                    "label": "Cover PDF",
                    "link": "#",
                    "count": 1
                },
                {
                    "label": "Events",
                    "link": "#",
                    "count": 2
                },
                {
                    "label": "Health Policy Briefs",
                    "link": "#",
                    "count": 6
                },
                {
                    "label": "Podcast",
                    "link": "#",
                    "count": 3
                },
                {
                    "label": "Biology",
                    "link": "#",
                    "count": 7
                },
                {
                    "label": "Martinez, Fernando J",
                    "link": "#",
                    "count": 167
                },
                {
                    "label": "Technical Topics",
                    "link": "#",
                    "count": 36
                },
                {
                    "label": "Biology",
                    "link": "#",
                    "count": 7
                }
            ]
        })


    | #{''}

    section.source_section
        h2 Examples

        h3!= data.items[1].title
        markdown
        p This example to show all items without More link

        .source_example
          .sidebar-region.accordion
            h2.sidebar-region__title.border Related Content
            | !{data.items[1].body}

        h3!= data.items[0].title
        markdown
        p This example to show only 5 items & if it exceen five link the show more link appears
        .source_example
            .sidebar-region.accordion
                h2.sidebar-region__title.border Related Content
                | !{data.items[0].body}

    | #{''}


