extends /specs/products/hope/page-structure/structure/templates/structure/layout-tmpl.jade



block content

    h1 Events page
    section.source_section
        h2 Events page
        markdown
        code.src-html
        .source_example
            | !{data.header}
            main.content
                .container
                   | !{pb.render("html", data.socialLinks)}




                .container
                    .row
                        .col-sm-12
                            h1.main-title Events
                    .row
                        .col-sm-8
                            | !{data.searchresult}
                         .col-md-4.col-sm-4.sidebar-region
                           | !{data.upcommingEvents}
                           each facet, l in data.eventArchive
                                 | !{facet}





            | !{data.footer}
    | #{''}