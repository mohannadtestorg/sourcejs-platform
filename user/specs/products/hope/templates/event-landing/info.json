{
    "title": "Event Landing page",
    "tag": ["templates"],
    "clearview": true,
    "templateData": {
        "header":{
            "$pug": {
                "template": "../header/templates/header/header-tmpl.jade",
                "data": {
                    "$ref": "../header/templates/data/header.json"
                }
            }
        },
        "socialLinks": {
            "thisWidget": {
                "id": "htmlAssetwrapper",
                "properties": {
                    "html":  "<ul class=\"social-links rlist rlist--inline\"> <li> <a href=\"#\" title=\"youtube\" class=\"social-links__item\"> <i class=\"icon-youtube\"></i> </a> </li> <li> <a href=\"#\" ttile=\"RSS\" class=\"social-links__item\"> <i class=\"icon-Rss\"></i> </a> </li> <li> <a href=\"#\" title=\"facebook\" class=\"social-links__item\"> <i class=\"icon-facebook\"></i> </a> </li> <li> <a href=\"#\" title=\"twitter\" class=\"social-links__item\"> <i class=\"icon-twitter\"></i> </a> </li> </ul>"
                }
            }
        },
        "upcommingEvents":{

            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "flase",
                            "className": [
                                "className"
                            ],
                            "markup": "section",
                            "headingLevel": "h2",
                            "headingClass": [
                                "sidebar-region__title border"
                            ]
                        },
                        "data": {
                            "title":"Upcoming Events",
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/widgets/html/templates/html/html-tmpl.jade",
                                    "data": {
                                        "thisWidget": {
                                            "id": "UpcomingEvents",
                                            "properties": {
                                                "render": "html",
                                                "html": "<div class='sidebar-region__wrapper'><div class='sidebar-region__content'><ul class='rlist sidebar-region__list'><li><a href='#' title='Event Page A'><span class='sidebar-region__label'>Event Page A</span><span class='pull-right'>8/2017</span></a></li><li><a href='#' title='Event Page B'><span class='sidebar-region__label'>Event Page B</span><span class='pull-right'>9/2017</span></a></li></ul></div></div>"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                }
            }
        },
        "eventArchive":{

                "$pug": {
                    "template": "templates/event-landing/extended/ext-search-facets-tmpl.jade",
                    "data": {
                        "$ref": "templates/data/facet.json"
                    }
                }
        },
        "searchresult": {
            "$pug": {
                "template": "templates/event-landing/extended/ext-demo-search-result-tmpl.jade",
                "data": {
                    "$ref": "templates/data/data.json"
                }
            }
        },
        "footer":{
            "$pug": {
                "template": "../footer/templates/footer/footer-tmpl.jade",
                "data": {
                    "$ref": "../footer/templates/data/footer.json"
                }
            }
        }
    }
}