{
    "title": "Podcast Category page",
    "tag": ["templates"],
    "clearview": true,
    "templateData": {
        "header":{
            "$pug": {
                "template": "../header/templates/header/header-tmpl.jade",
                "data": {
                    "$ref": "../header/templates/data/header.json"
                }
            }
        },
        "socialLinks": {
            "thisWidget": {
                "id": "htmlAssetwrapper",
                "properties": {
                    "html":  "<ul class=\"social-links rlist rlist--inline\"> <li> <a href=\"#\" title=\"youtube\" class=\"social-links__item\"> <i class=\"icon-youtube\"></i> </a> </li> <li> <a href=\"#\" ttile=\"RSS\" class=\"social-links__item\"> <i class=\"icon-Rss\"></i> </a> </li> <li> <a href=\"#\" title=\"facebook\" class=\"social-links__item\"> <i class=\"icon-facebook\"></i> </a> </li> <li> <a href=\"#\" title=\"twitter\" class=\"social-links__item\"> <i class=\"icon-twitter\"></i> </a> </li> </ul>"
                }
            }
        },
        "topicInfo": {
            "thisWidget": {
                "id": "htmltopicInfo",
                "properties": {
                    "html":  "<div class='podcast-category__info'><div class='main-title'>Narrative Matters</div><a title='Health Affairs Narrative Matter' class='podcast-category__desc'>Health Affairs Narrative Matter Podcast highlight the authors thoughts on that months </a><a a title='Journal article title ' class='podcast-category__desc'>Journal article title </a></div>"
                }
            }
        },

        "podcastCategory":{

            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "flase",
                            "className": [
                                "className"
                            ],
                            "markup": "section",
                            "headingLevel": "h2",
                            "headingClass": [
                                "sidebar-region__title border"
                            ]
                        },
                        "data": {
                            "title":"Podcast Archive",
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/widgets/html/templates/html/html-tmpl.jade",
                                    "data": {
                                        "thisWidget": {
                                            "id": "UpcomingEvents",
                                            "properties": {
                                                "render": "html",
                                                "html": "<div class='sidebar-region__wrapper' data-more-count='-3'><h4 class='sidebar-region__ctrl  sidebar-region__group-title'>Category</h4><div class='sidebar-region__content'><ul class='rlist sidebar-region__list'><li><a href='#' title='Conversation'><span class='sidebar-region__label'>Conversation</span><span class='pull-right'>2</span></a></li><li><a href='#' title='Events'><span class='sidebar-region__label'>Events</span><span class='pull-right'>10</span></a></li><li class='selected'><a href='#' title='Narrative Matters'><span class='sidebar-region__label'>Narrative Matters</span><span class='pull-right'>10</span></a></li><li><a href='#' title='Newsmarkers'><span class='sidebar-region__label'>Newsmarkers</span><span class='pull-right'>10</span></a></li></ul></div></div>"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                }
            }
        },

        "searchresult": {
            "$pug": {
                "template": "templates/podcast-category/extended/ext-demo-search-result-tmpl.jade",
                "data": {
                    "$ref": "templates/data/data.json"
                }
            }
        },
        "footer":{
            "$pug": {
                "template": "../footer/templates/footer/footer-tmpl.jade",
                "data": {
                    "$ref": "../footer/templates/data/footer.json"
                }
            }
        }
    }
}