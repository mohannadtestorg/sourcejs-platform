.do-full
    .col-xs-12
        .do-full__label Podcasts
    .col-md-8
        .clearfix.do-full__box
            .do-full__cover
                img(style='-webkit-user-select: none;background-position: 0px 0px, 10px 10px;background-size: 20px 20px;background-image:linear-gradient(45deg, #eee 25%, transparent 25%, transparent 75%, #eee 75%, #eee 100%),linear-gradient(45deg, #eee 25%, white 25%, white 75%, #eee 75%, #eee 100%);', src='http://via.placeholder.com/158x158')
            .do-full__body
                span.filled.default.do-full__head Podcast: newsmakers
                h1.do-full__title The Senate's Debate On Repealing And Replacing Obamacare
                ul.do-full__authors.rlist.comma
                    li.do-full__author
                        a(href) Alan R. Weil
                .do-full__details
                    span.do-full__date July 26, 2017
                    span.do-full__access Free Access
                script(type='text/javascript' src='https://content.jwplatform.com/libraries/pPWNqxFA.js')
                .do-full__player.podcasts__player(data-podcast-file="http://www.healthaffairs.org/podcasts/narrativematters/hoff_timothy_battle_of_the_bundle.mp3")
                    span.do-full__player__title Listen
                    #podcasts__player
                .do-full__description.accordion
                    a.accordion__control.sub(href='#', title='Single Accordion Controller', aria-expanded='false', aria-controls='id60')
                        i.icon-section_arrow_d(aria-hidden='true')
                        span Preview Short Description
                    .accordion__content.bordered.do-full__description
                        | The Senate's Debate On Repealing And Replacing Obamacare Description, Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries.

        nav.stickybar.coolBar.trans.do-full__coolBar
            .stickybar__wrapper.coolBar__wrapper.clearfix(style='width: 756.656px; top: 157px;')
                ul.rlist.coolBar__first(data-cb-group='Article', data-cb-group-icon='icon-toc')
                    li.coolBar__section.coolBar--sections
                        a.coolBar__ctrl(href='#', data-db-target-for='sections', data-db-switch='icon-close_thin', title='Sections', data-slide-target='#sectionMenu')
                            i.icon-Icon_Section-menu(aria-hidden='true')
                            span Sections
                        #sectionMenu.coolBar__drop.rlist(data-db-target-of='sections')
                            ul.rlist.w-slide--list
                                li(role='menuitem')
                                    a.w-slide__hide(href='#sec1')
                                        span Full Text
                                li(role='menuitem')
                                    a.w-slide__hide(href='#sec3')
                                        span  CHROMATIC ADAPTATION MATRIX AND ITS CORRESPONDING PRIMARIES
                                li(role='menuitem')
                                    a.w-slide__hide(href='#sec4')
                                        span  POSSIBLE PRIMARIES AND COORDINATES FOR THE MODIFIED CAT02 MATRIX
                                li(role='menuitem')
                                    a.w-slide__hide(href='#sec5')
                                        span  FITTING THE VISUAL EXPERIMENTAL DATA
                                li(role='menuitem')
                                    a.w-slide__hide(href='#sec6')
                                        span  THE OPTIMUM SOLUTION
                    li.coolBar__section.coolBar--download
                        a.coolBar__ctrl(href='#')
                            i.icon-download(aria-hidden='true')
                            span Download Podcast
                ul.coolBar__second.rlist
                    li.coolBar__section.coolBar-tools
                        a.article-tools__ctrl(href='#', role='menuitem')
                            i.icon-Icon_Star-26(aria-hidden='true')
                            span Add to favorites
                    li.coolBar__section.coolBar-share
                        a.share__ctrl.w-slide__btn(href='#', data-db-target-for='22945ae0-2b6a-4231-9667-e0f4f2a14628', data-db-switch='icon-close_thin', data-slide-target='#22945ae0-2b6a-4231-9667-e0f4f2a14628')
                            i.icon-Icon_Share(aria-hidden='true')
                            span Share
                        #22945ae0-2b6a-4231-9667-e0f4f2a14628.share__block.fixed(data-db-target-of='22945ae0-2b6a-4231-9667-e0f4f2a14628')
                            ul.rlist.addthis.addthis_toolbox.addthis_default_style.addthis_32x32_style.w-slide--list
                                li
                                    a.addthis_button_facebook(title='Facebook', href='#')
                                        i.at-icon-wrapper.icon-facebook(aria-hidden='true')
                                        span Facebook
                                li
                                    a.addthis_button_twitter(title='Twitter', href='#')
                                        i.at-icon-wrapper.icon-twitter(aria-hidden='true')
                                        span Twitter
                                li
                                    a.addthis_button_linkedin(target='_blank', title='LinkedIn', href='#')
                                        i.at-icon-wrapper.icon-linkedin(aria-hidden='true')
                                        span Linked In
                                li
                                    a.addthis_button_google_plusone_share(target='_blank', title='Google+', href='#')
                                        i.at-icon-wrapper.icon-Icon_Google-plus(aria-hidden='true')
                                        span
                                            | Google+
                                            | Share
                                li
                                    a.addthis_button_reddit(target='_blank', title='Reddit', href='#')
                                        i.at-icon-wrapper.icon-Icon_Share(aria-hidden='true')
                                        span Reddit
                                li
                                    a.addthis_button_email(target='_blank', title='Email', href='#')
                                        i.at-icon-wrapper.icon-Icon_mail(aria-hidden='true')
                                        span Email
                                .atclear

