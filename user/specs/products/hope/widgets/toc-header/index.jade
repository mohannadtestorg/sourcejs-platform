extends /specs/products/hope/page-structure/structure/templates/structure/layout-tmpl.jade


block content

    include /specs/page-structure/helpers/print-json-mixin.jade
    include /specs/page-structure/helpers/print-js-code-mixin.jade

    .source_info
        pShow the TOC header
    section.source_section
        h2 Usage
        h3 Include template
        +printJsCode('include /specs/products/hope/widgets/toc-header/templates/toc-header/toc-header-tmpl.jade')
        h3 Data
        p The following data structure must exist to be able to use toc-header template.
        +printJson({
            "data": {
                "title": "Advanced Illness End-Of-Life Care",
                "date": "July 2017",
                "volume": "36",
                "number": "7"
            }
        })
        markdown


    section.source_section
        h2 Basic image types

        if (data.items)
            each item , i in data.items
                h3!= item.title
                .source_example
                    | !{item.body}
    | #{''}