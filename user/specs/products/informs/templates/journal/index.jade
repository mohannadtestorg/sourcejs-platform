extends /specs/products/informs/page-structure/structure/templates/structure/layout-tmpl.jade



block content

    h1 Journal Home page
    .source_info



    section.source_section
        h2 Journal Home page
        markdown
        .source_example
            | !{pb.render("header", "header/demo/header")}
            main.content.journal-home
                .meta-wrapper

                .container
                    | !{pb.render('html', {"thisWidget": {"id": "htmlAssetwrapper", "properties": {"render": "html", "html": "<div class=\"card card--gutter card--shadow meta__body\"><div class=\"meta__left-side left-side-image\"><img alt=\"cover\" src=\"http://ux3-proto.literatumonline.com/resources/cms/settings/fum/publications/fca/cover.png\"><h1 class=\"meta__title\">Journal of Aerospace Engineering</h1><div class=\"meta__info\"><p>ISSN (print): 0893-1321 | ISSN (online): 1943-5525</p><p>Frequency: Bimonthly | Sponsored by the Aerospace Division</p></div><p class=\"meta__contrib\">Editor: Wieslaw Binienda, Ph.D., F.ASCE, University of Akron</p></div><div class=\"meta__right-side\"><a href\"#=\"href\" #\"=\"\" class=\"btn btn--inverse btn--journal-meta\">Submit an article</a><a href\"#=\"href\" #\"=\"\"class=\"btn btn--inverse btn--journal-meta\">Subscribe</a></div></div>"}}}, {"shared": {"model": {"config": {"wrapper": "false"}}}})}
                    | !{pb.render('list-of-issues', 'loi-data.json', {"shared": {"model": {"config": {"wrapper": "false"}}}})}
                    .row.separator
                        .col-md-8.col-sm-7.gutterless
                            | !{pb.render('top-content', 'data.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["grid-sm-2 "], "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "LATEST ARTICLES"}}}})}

                        .col-md-4.col-sm-5
                            h3.section__header.border-bottom newsletter
                            | !{pb.render('newsletter', 'newsletter.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["card--dark", "card--gutter"]}}}})}

                            //mpu ad
                            .mpu
                    .row.separator
                        .col-md-8.col-sm-7
                            | !{pb.render('cover-image', {"thisWidget": {"id": "pbr5", "properties": {"displayStyle": "singleCover", "actions": "linkToIssueOrBook"}}, "data": {"single": {"coverImage": {"src": "/specs/ux3/build/images/components/teaser/news.png"}, "serial": {"contentType": "Journal", "serialTitle": "Journal Title"}, "linkURL": "http://nine-lts.literatumonline.com/toc/bio/9/4"}},"errors": []}, {"shared": {"model": {"config": {"wrapper": "false", "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "News"}}}})}

                    .row.separator--extra

                        .col-md-8.col-sm-7.gutterless
                            | !{pb.render('top-content', 'recommended.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["grid-sm-2"], "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "Recomended"}}}})}
                            | !{pb.render('top-content', 'recommended.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["grid-sm-2"], "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "Most cited"}}}})}
                            | !{pb.render('top-content', 'recommended.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["grid-sm-2"], "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "Most read"}}}})}

                        .col-md-4.col-sm-5
                            | !{pb.render('tweets', {"body": [{"screenName": "TwitterDev", "theme": "dark", "height": "800"}]}, {"shared": {"model": {"config": {"wrapper": "false", "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "Twitter"}}}})}

            | !{pb.render("footer", "footer/demo/footer")}
    | #{''}