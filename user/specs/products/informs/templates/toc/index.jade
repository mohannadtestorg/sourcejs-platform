extends /specs/products/informs/page-structure/structure/templates/structure/layout-tmpl.jade

block content

    h1 Table Of Content page

    section.source_section
        h2 Table Of Content page
        markdown
        code.src-html
        .source_example
            | !{pb.render("header", "header/demo/header")}

            main.content.toc
                .meta-wrapper

                .container
                    | !{pb.render('html', {"thisWidget": {"id": "htmlAssetwrapper", "properties": {"render": "html", "html": "<div class=\"card card--gutter card--shadow meta__body\"><div class=\"meta__left-side\"><h1 class=\"meta__title\">Journal of Aerospace Engineering</h1><div class=\"meta__info\"><p>ISSN (print): 0893-1321 | ISSN (online): 1943-5525</p><p>Frequency: Bimonthly | Sponsored by the Aerospace Division</p></div><p class=\"meta__contrib\">Editor: Wieslaw Binienda, Ph.D., F.ASCE, University of Akron</p></div><div class=\"meta__right-side\"><a href\"#=\"href\" #\"=\"\" class=\"btn btn--inverse btn--journal-meta\">Submit an article</a><a href\"#=\"href\" #\"=\"\"class=\"btn btn--inverse btn--journal-meta\">Subscribe</a></div></div>"}}}, {"shared": {"model": {"config": {"wrapper": "false"}}}})}

                    | !{pb.render('list-of-issues', 'list-of-issues/demo/list-of-issues-demo', 'loi-data.json', {"shared": {"model": {"config": {"wrapper": "false"}}}})}
                    .row.separator
                        .col-md-8.col-sm-7
                            | !{pb.render('table-of-content', 'table-of-content/markup')}

                        .col-md-4.col-sm-5
                            h3.section__header.border-bottom newsletter
                            | !{pb.render('newsletter', 'newsletter.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["card--dark", "card--gutter"]}}}})}

                            //mpu ad
                            .mpu
                            | !{pb.render('html', {"thisWidget": {"id": "htmlAssetwrapper", "properties": {"render": "html", "html": "<h3 class=\"section__header border-bottom\">News</h3><div class=\"creative-work\"><a href=\"/doi/full/10.1061/%28ASCE%29CP.1943-5487.0000527\" title=\"Bridge Column Maximum Drift Estimation via Computer Vision\"><h5>EDITOR'S CHOICE Efficient Analysis of HALE Aircraft Structure for Static Aeroelastic Behavior</h5></a><p>In this work, the static aeroelastic behavior of flexible aircraft with a high aspect ratio wing undergoing large static deformations has been investigated analytically and numerically. Read more...</p><a href=\"/doi/full/10.1061/%28ASCE%29CP.1943-5487.0000527\" title=\"Bridge Column Maximum Drift Estimation via Computer Vision\"><img src=\"/specs/ux3/build/images/components/teaser/news.png\" alt=\"Bridge Column Maximum Drift Estimation via Computer Vision\" title=\"Bridge Column Maximum Drift Estimation via Computer Vision\" class=\"creative-work__img\"></a></div>"}}}, {"shared": {"model": {"config": {"wrapper": "false"}}}})}
 
                            | !{pb.render('tweets', {"body": [{"screenName": "TwitterDev", "theme": "dark", "height": "800"}]}, {"shared": {"model": {"config": {"wrapper": "false", "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "Twitter"}}}})}

            | !{pb.render("footer", "footer/demo/footer")}

    | #{''}
