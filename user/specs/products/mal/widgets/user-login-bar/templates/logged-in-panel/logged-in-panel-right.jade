- var random = Math.random().toString(36).substring(2,5);

.userLoginBar.right-side.pull-right(data-db-parent-of="target-" + random)
    a.quick-menu__item.userLoginBar__controller(href="#" data-db-target-for="target-" + random)
        if(model.data && model.data.controller && model.data.controller.icon)
          i.block-icon(class= model.data.controller.icon aria-hidden="true")
        span
            if(model.data && model.data.controller && model.data.controller.text)
              | !{model.data.controller.text}
    ul.rlist.base.spaced.userLoginBar__holder(data-db-target-of="target-" + random)
        each item, i in model.data.body
            li
                if(item.text)
                  a(href = item.url)
                    | !{item.text}