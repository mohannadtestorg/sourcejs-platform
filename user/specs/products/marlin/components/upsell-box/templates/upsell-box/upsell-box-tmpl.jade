section.upsell-box.clearfix
    .row
        .col-sm-5
            a.upsell-box__banner.upsell-box__control(href="#" title="Purchase one-time access") Purchase one-time access
            .upsell-box__wrapper
                a.upsell-box__action.block(href="#" title="Or purchase Read-It-Now") Or purchase Read-It-Now
                .upsell-box__body Access all research journal HTML articles for 6 or 36 hours
        .col-sm-7
            a.upsell-box__banner.upsell-box__control(href="#" title="Subscribe to Cell")
                span Subscribe to
                i  Cell
            .upsell-box__wrapper
                .upsell-box__item
                    span.upsell-box__suffix Already a print subscriber?
                    a.upsell-box__action(href="#" title="Claim online access")  Claim online access
                .upsell-box__item
                    span.upsell-box__suffix Already an online subscriber?
                    a.upsell-box__action(href="#" title="Sign in")  Sign in
                .upsell-box__item
                    span.upsell-box__suffix Register:
                    a.upsell-box__action(href="#" title="Create an account")  Create an account
                .upsell-box__item
                    span.upsell-box__suffix Institutional Access:
                    a.upsell-box__action(href="#" title="Sign in to ScienceDirect")  Sign in to ScienceDirect