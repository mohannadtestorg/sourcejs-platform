            block headerLogo
                a.journal-logos(href="/" title="Go home")
                    img(src='/specs/products/marlin/lancet/components/journal-logos/images/TLPH.svg', alt='lancet logo')
        .col-xs-6
            .header__nav.row
                | !{pb.render("menu", "mainMenu.json")}
                | !{pb.render("quick-search","demo/quick-search", "quick-search.json")}
                | !{pb.render("profile-links", "profile-links-logged-in.json")}