        box-sizing: border-box;
    }

    .ux3 .article-comment .btn-block, .ux3 .article-comment .input--text, .ux3 .article-comment button.alert {
        width: 100%;
    }

    .ux3 .article-comment input[type=button].btn-block, .ux3 .article-comment input[type=reset].btn-block, .ux3 .article-comment input[type=submit].btn-block {
        width: 100%;
    }

