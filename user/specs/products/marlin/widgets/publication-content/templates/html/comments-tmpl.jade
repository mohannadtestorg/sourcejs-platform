        content: "";
    }

    .ux3 .article-comment q:after, .ux3 .article-comment q:before {
        content: "";
    }

    .ux3 .article-comment .btn, .ux3 .article-comment .btn-link {
        cursor: pointer;
    }

    .ux3 .article-comment .btn:hover, .ux3 .article-comment a {
        text-decoration: none;
    }

    .ux3 .article-comment .dropdown-menu, .ux3 .article-comment ol, .ux3 .article-comment ul {
        list-style: none;
        padding-left: 0 !important;
    }

    .ux3 .article-comment .dropdown-menu li:before, .ux3 .article-comment ol li:before, .ux3 .article-comment ul li:before {
        display: none !important;
    }

