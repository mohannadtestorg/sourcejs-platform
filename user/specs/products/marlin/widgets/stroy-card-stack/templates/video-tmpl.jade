mixin audioItem(itemo)
    .related-audio.mediaPlayer.video(data-mediaPlayer-file = itemo.mediaUrl)
        script(type='text/javascript' src='https://content.jwplatform.com/libraries/2mX68iCO.js')
        .mediaPlayer__player
            .mediaPlayer__player-holder
                .mediaPlayer__laoding Loading ...
        if (itemo.fileDetails)
            a.mediaPlayer__download.mediaPlayer__control(href=itemo.mediaUrl, title="Download audio") Download audio (!{itemo.fileDetails})
        .mediaPlayer__subtitle !{itemo.title}
        .mediaPlayer__description !{itemo.description}
        a.mediaPlayer__showAll.mediaPlayer__control(href=itemo.URI) Browse all The Lancet audio


section
    h2#rel3 Related Video
    if (data && data.Items)
        if (data.Items.length > 1 )
            .tab.related-audio--tabs
                ul(role="tablist" class="rlist tab__nav")
                    each item , i in data.Items
                        li(role="presentation")
                            - var classes = ""
                            if (i == 0)
                                - classes= "active"
                            a(href="#video-pane-" + i, aria-controls="video-pane-" + i, role="tab" data-toggle="tab" title=i id="video-pane-" + i + "-con" aria-selected="true" class="related-audio__control" + classes) !{i + 1}
                ul.rlist.tab__content
                    each item , i in data.Items
                        - var classes = ""

                        if (i == 0)
                            - classes= "active"
                        li(id="video-pane-" + i aria-labelledby="#video-pane-" + i + "-con" role="tabpanel" class="tab__pane " + classes)
                            +audioItem(item)
        else
            +audioItem(data.Items[0])