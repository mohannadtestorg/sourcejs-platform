section
        header.m-generic-heading
                h1.m-generic-heading__title Advanced Search

        form.o-form-lg
            fieldset.o-form-lg__fieldset.o-form-lg__fieldset--legend-as-label

                p.a-error-msg
                    svg.icon--alert(aria-hidden='true')
                        use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--alert')
                    |             Volume and/or page number do not have the correct format.
                legend Citation

                ol
                    li.s-error
                        label.a-label(for='volume') Volume

                        input#volume(type='text', name='volume')

                    li.s-error
                        label.a-label(for='page') Page

                        input#page(type='text', name='page')

            p.o-form-lg__submit
                button.a-btn(type='submit')
                    | Search
                    svg.icon--arrow(aria-hidden='true')
                        use(xlink:href='#icon--arrow')

        form.o-form-lg

            fieldset.o-form-lg__fieldset
                p.a-error-msg
                    svg.icon--alert(aria-hidden='true')
                        use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--alert')
                    |             Please enter a search term or author.


                legend Search by keywords

                p.f-blurb
                    | Enter as much or as little information as you like. Blank fields will be ignored.
                    a(href='#') Tips for searching.

                ol
                    li.s-error
                        label.a-label(for='search_all_words') All the words

                        input#search_all_words(type='text', name='search_all_words')

                    li
                        label.a-label(for='search_exact_phrase') Exact phrase

                        input#search_exact_phrase(type='text', name='search_exact_phrase', data-input-exact-phrase='')

                    li
                        label.a-label(for='search_one_word') At least one word

                        input#search_one_word(type='text', name='search_one_word')

                    li
                        label.a-label(for='search_without_words') Without the words

                        input#search_without_words(type='text', name='search_without_words')

                    li
                        label.a-label(for='search_within') Search within

                        span.a-form-select
                            select(name='search_within', data-behavior='DisableExactPhrase')
                                option Full text

                                option Title

                                option Abstract/Extract

            fieldset.o-form-lg__fieldset
                legend Search by author

                ol
                    li
                        label.a-label(for='search_author') Author

                        input#search_author(type='text')

                        em.a-form-hint Names separated by semicolon

                        ul
                            li
                                span.a-form-radio
                                    input#advanced_search_author_all(type='radio', value='all', name='search_author_type', checked='')

                                    label.a-label(for='advanced_search_author_all') All

                            li
                                span.a-form-radio
                                    input#advanced_search_author_any(type='radio', value='any', name='search_author_type')

                                    label.a-label(for='advanced_search_author_any') Any

            fieldset.o-form-lg__fieldset
                legend Search by article category and/or date

                ol
                    li
                        label.a-label(for='article_category') Article category

                        span.a-form-select
                            select(name='article_category')
                                option All

                                option Research

                                option Commentary

                                option Perspective

                                option Clinical Cases

                                option Review

                                option Other

                    li.o-form-lg__date-range
                        label.a-label(for='date_range') Date

                        input#dateControlDateList(type='radio', name='dateControl', value='dateList', data-daterange-datelist='', checked='')

                        input#dateControlCustom(type='radio', name='dateControl', value='custom', data-daterange-custom='')

                        span.a-form-select(data-daterange-datelist='')
                            select(name='date_range')
                                option All Dates (1812-Present)

                                option.a-fake-checkbox(href='/templates/search-results--articles--2-tabs--active-filter.html') Past 6 months

                                option.a-fake-checkbox(href='/templates/search-results--articles--2-tabs--active-filter.html') Past year

                                option.a-fake-checkbox(href='/templates/search-results--articles--2-tabs--active-filter.html') Past 2 years

                                option.a-fake-checkbox(href='/templates/search-results--articles--2-tabs--active-filter.html') Past 5 years

