    div(data-pb-dropzone='main')
        .container
            .row.row-md.gutterless
                .col-md-1-1
                    .discussionModeration
                        h1.title Moderate Comments
                        form#commentSearch(action='/action/discussionModeration', name='commentSearch', method='post')

                            .input-group
                                label.a-label(for='discussionTitle') Discussion title
                                input#discussionTitle(type='text', name='discussionTitle')

                            .input-group
                                label.a-label(for='discussionDoi') DOI
                                input#discussionDoi(type='text', name='discussionDoi')

                            .input-group
                                label.a-label(for='commenter') Submitted by
                                input#commenter(title='Email', type='text', name='commenter')

                            .input-group
                                label.a-label(for='approver') Approved by
                                input#approver(title='Email', type='text', name='approver')

                            .input-group
                                label.a-label(for='status') Status
                                select#status(name='status')
                                    option(value='') All Statuses
                                    option(value='REJECTED') Rejected
                                    option(value='NOT_RECOMMENDED') Not Recommended
                                    option(value='PENDING_MODERATION') Pending Moderation
                                    option(value='RECOMMENDED') Recommended
                                    option(value='APPROVED') Approved

                            .input-group
                                label.a-label(for='startDate') Submitted between
                                input#startDate.XCalendar.between(title='yyyy-MM-dd HH:mm:ss', type='text', name='startDate')
                                label.and(for='endDate') And
                                input#endDate.XCalendar.between(title='yyyy-MM-dd HH:mm:ss', type='text', name='endDate')

                            .submit
                                input#searchButton.a-btn(type='submit', name='searchButton', value='Search')
                                input#downloadButton.a-btn.downloadTSV(type='submit', name='downloadButton', value='Download')

