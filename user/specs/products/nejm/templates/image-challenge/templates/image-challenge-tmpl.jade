aside.m-cta.m-cta--image-challenge.m-cta--image-challenge-primary
    p.a-subtitle
        a(href='#')
            | Image Challenge
            svg.icon--arrow(aria-hidden='true')
                use(xlink:href='#icon--arrow')

    .m-cta__image-challenge-image
        span.m-cta__image-challenge-image-container
            img(src='http://placehold.dev.area17.com/image/300x200', sizes='(min-width: 1480px) 120px, (min-width: 1280px) 8.3vw, (min-width: 1024px) 8.3vw, (min-width: 768px) 12.5vw, (min-width: 480px) 16.67vw, calc(((100vw - 112px) / 6) * 2)', width='300', height='200')

    p.m-cta__image-challenge-prompt.f-blurb
        strong What is the diagnosis?

        a.f-related(href='#') Answer &raquo;
