.o-col.o-col--secondary.o-col--keyline-top
        .m-promo.m-promo--submit-manuscript(class='u-hide@medium-')
            p.m-promo__title.f-caps Submit a manuscript or letter

            p.m-promo__actions
                a.a-btn.a-btn--primary.a-btn--icon-first(href='#')
                    svg.icon--arrow.icon--arrow--external(aria-hidden='true')
                        use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--arrow')
                    |  NEJM Online Submission

                br

                a.a-btn.a-btn--fake-link(href='#') Create account

