.g-nav__primary-item.g-nav__primary-item--search
    a(href='#search', data-behavior='SearchToggle', aria-label='search', title='search')
        | Search
        svg.icon--search
            use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--search')

        svg.icon--close(aria-hidden='true')
            use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--close')
#search.g-search
    form.g-search__form(action='/templates/search.php', data-behavior='SearchSuggestions', data-searchsuggestions-action='/endpoints/SearchSuggestions.php')
        fieldset.g-search__fieldset-primary-input
            legend Search site
            ol
                li.g__search__keywords
                    label.a-label(for='search_keyword') Keyword
                    input#search_keyword(type='text', name='search_keyword', placeholder='Enter keyword, author, title or citation', autocomplete='off', data-gsearch-keyword-input='')
                li.g-search__advanced-link--text
                    a(href='/advanced-search', aria-label='advanced search', title='advanced search')
                        | Advanced Search
        button.g-search__submit-btn(aria-label='search', title='search', type='submit', data-gsearch-submit='')
            svg.icon--search
                use(xlink:href='#icon--search')

