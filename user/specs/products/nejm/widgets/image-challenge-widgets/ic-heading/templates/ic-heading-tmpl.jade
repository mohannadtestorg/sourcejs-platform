.m-title-options-block.m-title-options-block--with-social-links
  p.m-title-options-block__title.f-h11 February 2, 2017
  ul.m-title-options-block__options
    li.m-title-options-block__option(class='u-hide@medium-')
      ul.m-boxed-icon-links
        li
          a(href='#')
            svg.icon--facebook(aria-label='Facebook')
              use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--facebook')
        li
          a(href='#')
            svg.icon--twitter(aria-label='Twitter')
              use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--twitter')
        li
          a(href='#')
            svg.icon--linkedin(aria-label='LinkedIn')
              use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--linkedin')
        li
          a(href='#')
            svg.icon--more(aria-label='More share options')
              use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--more')
    li.m-title-options-block__option(class='u-hide@large+')
      span.a-dropdown(aria-title='Share page', data-behavior='Dropdown ToolTip', data-tooltip='Share page', data-tooltip-direction='bottom', data-tooltip-breakpoints='large xlarge xxlarge', tabindex='0')
        button(tabindex='-1')
          svg.icon--share(aria-label='Share article')
            use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--share')
        ul
          li
            a(href='#') Facebook
          li
            a(href='#') Twitter
          li
            a(href='#') Google+
          li
            a(href='#') LinkedIn
          li
            a(href='#') Email
          li
            a(href='#', data-behavior='CopyUrl') Copy URL
    li.m-title-options-block__option(class='u-hide@medium-')
      a(href='#', data-behavior='ToolTip', data-tooltip='Download slide', data-tooltip-direction='bottom', data-tooltip-breakpoints='large xlarge xxlarge')
        svg.icon--download(aria-label='Download PDF')
          use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--download')
