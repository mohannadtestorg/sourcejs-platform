h2.a-subtitle Manage IP Addresses
p.m-deflist__intro.f-body--sm Add or edit your institution&apos;s IP Address(es) below.

form.m-deflist(action='#', data-behavior='AddRemoveDefListItem', data-placeholder-name='ip[{{id}}][{{type}}]')
    .m-deflist__dl(data-items='')
        dl(class='u-hide@xsmall')
            dt
                strong Description

            dd
                strong IP Address(es)

        dl(data-item='0')
            dt
                textarea(name='ip[0][description]', data-type='description', rows='1') Lorem ipsum dolor sit amet

            dd
                a(href='#', title='Delete', data-remove='0')
                    svg.icon--trash
                        title Delete
                        use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--trash')

                textarea(name='ip[0][range]', data-type='range', rows='2') 111.111.222.222

        dl(data-item='1')
            dt
                textarea(name='ip[1][description]', data-type='description', rows='1') Aries Systems Corporation

            dd
                a(href='#', title='Delete', data-remove='1')
                    svg.icon--trash
                        title Delete
                        use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--trash')

                textarea(name='ip[1][range]', data-type='range', rows='2') 196.115.092.000 : 196.115.093.255

        dl(data-item='2')
            dt
                textarea(name='ip[2][description]', data-type='description', rows='1') Massachusetts Medical Society

            dd
                a(href='#', title='Delete', data-remove='2')
                    svg.icon--trash
                        title Delete
                        use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--trash')

                textarea(name='ip[2][range]', data-type='range', rows='2')
                    | 69.38.128.106
                    | 69.89.31.226

        dl(data-item='3')
            dt
                textarea(name='ip[3][description]', data-type='description', rows='1') Lorem ipsum dolor sit amet

            dd
                a(href='#', title='Delete', data-remove='3')
                    svg.icon--trash
                        title Delete
                        use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--trash')

                textarea(name='ip[3][range]', data-type='range', rows='2') 172.16.254.1

    .m-deflist__submits
        a.a-btn.a-btn--simple.m-deflist__submits--secondary(href='#', data-add='')
            svg.icon--plus--sm
                use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--plus--sm')
            |  Add IP Address

        a.a-btn.a-btn--simple(href='/templates/institution-account-manage.php?bannerInstitution=2') Cancel

        button.a-btn.a-btn--no-icon(type='submit') Save Changes

    script#template__IPAdress(type='text/template').
      <dl data-item>
      <dt class="m-deflist__dt f-body--sm"><textarea name="ip[][description]" data-type="description" rows="1"></textarea></dt>
      <dd class="m-deflist__dd f-body--sm">
      <a href="#" title="Delete" data-remove><svg class="icon--trash" aria-label="Delete"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon--trash"></use></svg></a>
      <textarea name="ip[][range]" data-type="range" rows="2"></textarea>
      </dd>
      </dl>





.m-deflist__action
    p.f-ui
        a(href='/templates/help-with-IP-address.php', data-behavior='OpenInModal') Help with IP Addresses
