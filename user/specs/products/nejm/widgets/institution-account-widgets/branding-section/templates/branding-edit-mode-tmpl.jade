h2.a-subtitle Institution Branding

form.m-deflist(action='#', enctype='multipart/form-data')
    dl.m-deflist__dl
        dt
            strong Institution Text

            i Inform users that access to nejm.org is being provided by your institution.

        dd
            input(type='text', value='Columbia University', maxlength='60')

            i.m-deflist__notes Max 60 characters

    dl.m-deflist__dl.m-deflist__dl--sep
        dt
            strong Institution Logo

            i
                | If you wish to display your institution&apos;s logo along with the text, upload the logo.

        dd
            img.m-deflist__img(src='http://www.nejm.org/userimages/958194/banner?trick=1500975326912')

            span.a-form-file(data-behavior='CheckFileUpload')
                input#imageFile(type='file', value='', name='imageFile', accept='image/jpeg, image/jpg, image/png, image/gif, image/bmp')

                label(for='imageFile', data-btn='Browse')

            i.m-deflist__notes Max 200 x 28 pixels

    .m-deflist__submits
        a.a-btn.a-btn--simple(href='/templates/institution-account-manage.php?bannerInstitution=2') Cancel

        button.a-btn.a-btn--no-icon(type='submit') Save Changes

.m-deflist__action
    p.f-ui
        a(href='/templates/help-with-institution-branding.php', data-behavior='OpenInModal') Help with Institution Branding
