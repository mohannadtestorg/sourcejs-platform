.o-colset-1-2
    .o-col.o-col--primary
        h2.a-subtitle Link Resolver

        .m-deflist.m-deflist--editable
            dl.m-deflist__dl
                dt
                    strong Link Server

                    em
                        | If your institution has a local OpenURL-compliant link server, you can choose to display OpenURL reference links.

                dd https://example.edu/openURL-link

            dl.m-deflist__dl
                dt
                    strong OpenURL Image

                    em If you do not upload an image, the default OpenURL image will display.

                dd
                    span.m-deflist__img Default

            a.a-btn.a-btn--simple.m-deflist__btn(href='/templates/institution-account-branding-edit.php?bannerInstitution=2')
                svg.icon--edit
                    use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--edit')
                |  Edit

        .m-deflist__action
            p.f-ui
                a(href='/templates/help-with-link-resolver.php', data-behavior='OpenInModal') Help with Link Resolver
