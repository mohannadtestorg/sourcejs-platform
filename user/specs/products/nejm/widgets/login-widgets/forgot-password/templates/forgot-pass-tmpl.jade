.m-intro-block
  p.f-body
    | Enter the email address associated with your account then click Continue. We will email you a link to a page where you can easily create a new password.
form.m-signin-form(action='#', method='post')
  fieldset
    ol
      li
        label.a-label(form='email') Email Address
        input#email(type='text', name='email')
  p.m-signin-form__btns
    button.a-btn.a-btn--no-icon(type='submit') Continue
