form.m-signin-form(action='#', method='post')
  fieldset
    ol
      li
        label.a-label(form='email') Email Address
        input#email(type='text', name='email')
      li
        label.a-label(form='password') Password
        input#password(type='password', name='password')
  p.m-signin-form__remember
    span.a-form-checkbox
      input#remember_me(type='checkbox', value='true', name='remember_me')
      label(for='remember_me') Remember me
    a.f-ui(href='#') Forgot password?
  p.m-signin-form__btns
    button.a-btn.a-btn--no-icon(type='submit') Sign In
  .m-signin-form__help
    p.f-ui
      | Don't have an account?
    ul.f-ui
      li
        a(href='#') Create an Account
      li
        a(href='#') Subscribe
  p.m-signin-form__footer.f-ui
    a(href='/templates/login-athens.php') Login via OpenAthens or your institution
