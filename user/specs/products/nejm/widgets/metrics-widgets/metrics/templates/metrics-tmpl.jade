section#article_metrics.o-article-body__section.o-article-body__section--allopened(data-article-section-title='Metrics')
  h2.o-article-body__section-title.a-article-h1.a-article-h1--underline.a-article-h1--allopened.f-h3
    | Metrics 
    i.o-article-body__section-tip(data-behavior='ShowPopupTip', data-popup-content-ids='article_metrics_hint')
  #article_metrics_hint.m-popup-tip-content
    p.f-body--xs
      | Metrics lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod
      | tempor incididunt ut labore et dolore magna aliqua.
  ul.o-colset-1-2-3.o-colset-1-2-3--gridlines-cols.o-colset-1-2-3--gridlines.o-colset-1-2-3--gridlines-rows
    li.o-col
      a.m-metric(href='#page_views')
        span.m-metric__title Page Views
        span.m-metric__icon
          svg.icon--metrics_page-views(aria-hidden='true')
            use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--metrics_page-views')
        span.m-metric__figure 58,984
    li.o-col
      a.m-metric(href='#citations')
        span.m-metric__title Citations
        span.m-metric__icon
          svg.icon--metrics_citations(aria-hidden='true')
            use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--metrics_citations')
        span.m-metric__figure 25
  ul.o-colset-1-2-3.o-colset-1-2-3--gridlines-cols.o-colset-1-2-3--gridlines.o-colset-1-2-3--gridlines-rows
    li.o-col
      a.m-metric(href='#media_coverage')
        span.m-metric__title Media Coverage
        span.m-metric__icon
          svg.icon--metrics_media-coverage(aria-hidden='true')
            use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--metrics_media-coverage')
        span.m-metric__figure 21
    li.o-col
      a.m-metric(href='#social_media')
        span.m-metric__title Social Media
        span.m-metric__icon
          svg.icon--metrics_social-media(aria-hidden='true')
            use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--metrics_social-media')
        span.m-metric__figure Ranks 117th
