p.m-deflist__intro.f-ui
    | Your print &amp; online subscription expires on April 27, 2017
    a(href='#') Obtain Receipt

form(action='#')
    h2.a-subtitle Account Information

    .m-deflist
        dl.m-deflist__dl
            dt.m-deflist__dt.f-body--sm Customer Number

            dd.m-deflist__dd.f-ui
                span.m-deflist__notes 123456789

        dl.m-deflist__dl.m-deflist__dl--fields.m-deflist__dl--sep
            dt.m-deflist__dt.f-body--sm
                label(for='accountEmail') Email Address

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountEmail(type='email', name='accountEmail', value='isaac@area17.com')

                em.m-deflist__notes.m-deflist__notes--left.f-hint This is also your log-in

            dt.m-deflist__dt.f-body--sm
                label(for='accountPassword') Password

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountPassword(type='password', name='accountPassword')

    h2.a-subtitle.a-subtitle--subtle Personal Information

    .m-deflist
        dl.m-deflist__dl.m-deflist__dl--fields
            dt.m-deflist__dt.f-body--sm
                label(for='accountFirstName') First Name

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountFirstName(type='text', name='accountFirstName', value='Isaac')

            dt.m-deflist__dt.f-body--sm
                label(for='accountLastName') Last Name

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountLastName(type='text', name='accountLastName', value='Daniels')

            dt.m-deflist__dt.f-body--sm
                label(for='accountCountry') Country / Region

            dd.m-deflist__dd.m-deflist__dd--field
                span.a-form-select
                    select(name='accountCountry')
                        option United States

                        option Option 1

                        option Option 2

                        option Option 3

            dt.m-deflist__dt.f-body--sm
                label(for='accountCompany')
                    | Company
                    em.m-deflist__optional.f-related (optional)

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountCompany(type='text', name='accountCompany', value='AREA 17')

            dt.m-deflist__dt.f-body--sm
                label(for='accountAddress') Address 1

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountAddress(type='text', name='accountAddress', value='99 Richardson St')

            dt.m-deflist__dt.f-body--sm
                label(for='accountAddressMore')
                    | Address 2
                    em.m-deflist__optional.f-related (optional)

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountAddressMore(type='text', name='accountAddressMore', value='Floor 3')

            dt.m-deflist__dt.f-body--sm
                label(for='accountCity') City

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountCity(type='text', name='accountCity', value='Brooklyn')

            dt.m-deflist__dt.f-body--sm
                label(for='accountState') State

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountState(type='text', name='accountState', value='New York')

            dt.m-deflist__dt.f-body--sm
                label(for='accountZip') ZIP Code

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountZip(type='text', name='accountZip', value='11211')

        dl.m-deflist__dl.m-deflist__dl--fields.m-deflist__dl--sep
            dt.m-deflist__dt.f-body--sm
                label(for='accountAddress') Professional Category

            dd.m-deflist__dd.m-deflist__dd--field
                span.a-form-select
                    select(name='accountCountry')
                        option Other

                        option Option 1

                        option Option 2

                        option Option 3

            dt.m-deflist__dt.f-body--sm
                label(for='accountAddressMore') Place of Work or Study

            dd.m-deflist__dd.m-deflist__dd--field
                span.a-form-select
                    select(name='accountCountry')
                        option Research Facility

                        option Option 1

                        option Option 2

                        option Option 3

            dt.m-deflist__dt.f-body--sm
                label(for='accountCity') Profession

            dd.m-deflist__dd.m-deflist__dd--field
                span.a-form-select
                    select(name='accountCountry')
                        option Nurse

                        option Option 1

                        option Option 2

                        option Option 3

            dt.m-deflist__dt.f-body--sm
                label(for='accountSpeciality') Speciality

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountSpeciality(type='text', name='accountSpeciality', value='Cardiovascular Disease')

            dt.m-deflist__dt.f-body--sm
                label(for='accountSecondarySpecialty')
                    | Secondary Specialty Fields
                    em.m-deflist__optional.f-related (optional)

            dd.m-deflist__dd.m-deflist__dd--field
                input#accountSecondarySpecialty(type='text', name='accountSecondarySpecialty', value='Unspecified')

    .m-deflist__action
        a.a-btn.a-btn--simple(href='#') Cancel

        button.a-btn.a-btn--no-icon(type='submit') Save Changes
