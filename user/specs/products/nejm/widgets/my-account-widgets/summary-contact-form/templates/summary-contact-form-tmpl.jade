form(action='#')
    h2.a-subtitle Contact Us

    .m-deflist
        dl.m-deflist__dl.m-deflist__dl--fields
            dt.m-deflist__dt.f-body--sm
                label(for='contactEmail') Email Address

            dd.m-deflist__dd.m-deflist__dd--field
                input#contactEmail(type='email', name='contactEmail', value='')

            dt.m-deflist__dt.f-body--sm
                label(for='contactFirstName') First Name

            dd.m-deflist__dd.m-deflist__dd--field
                input#contactFirstName(type='text', name='contactFirstName')

            dt.m-deflist__dt.f-body--sm
                label(for='contactLastName') Last Name

            dd.m-deflist__dd.m-deflist__dd--field
                input#contactLastName(type='text', name='contactLastName')

            dt.m-deflist__dt.f-body--sm
                label(for='contactReason') Contact Reason

            dd.m-deflist__dd.m-deflist__dd--field
                span.a-form-select
                    select#contactReason(name='contactReason')
                        option Lorem ipsum

                        option Option 1

                        option Option 2

                        option Option 3

            dt.m-deflist__dt.f-body--sm
                label(for='contactBody') Question or Comment

            dd.m-deflist__dd.m-deflist__dd--field
                textarea#contactBody(name='contactBody', rows='5')

    .m-deflist__action.m-deflist__action--closer
        button.a-btn(type='submit')
            | Submit
            svg.icon--arrow(aria-hidden='true')
                use(xmlns:xlink='http://www.w3.org/1999/xlink', xlink:href='#icon--arrow')
