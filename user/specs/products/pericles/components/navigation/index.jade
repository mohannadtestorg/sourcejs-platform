block content


    section.source_section
        h2 Example


        h3 Page menu
        markdown
            p we are using `HTML menu structure` for mobile view and `menu widget` for desktop view, used in journal pages and toc
            small note: we are using the transplant functionality to append the content for the small screen size "html structure"
        .source_example
            .pages-nav.hidden-xs.hidden-sm.hidden-md
                | !{pb.render('navigation', 'navigation/demo/ext-menu', 'page-menu-data.json', 'pericles')}


            .pages-nav.hidden-lg
                .pages-nav--res.container
                    ul.rlist--inline.pull-left
                        li
                            a(href='#', data-db-target-for='journal-list', data-db-switch='icon-close_thin')
                                i.icon-toc(aria-hidden='true')
                                span Journal

                            #journal-list.rlist.dropBlock__holder(data-db-target-of='journal-list')
                                .transplant.showit(data-target='#menu-item-1, #menu-item-2, #menu-item-4' data-remove='false' data-toggle='transplant' data-direction='from' data-transplant='self')
                        li
                            a(href='#', data-db-target-for='articles-list', data-db-switch='icon-close_thin')
                                i.article-img-icon
                                    img(src='https://image.ibb.co/fSKxJQ/articles_1.png', alt="")
                                span Articles

                            #articles-list.rlist.dropBlock__holder(data-db-target-of='articles-list')
                                .transplant.showit(data-target='#menu-item-3' data-remove='false' data-toggle='transplant' data-direction='from' data-transplant='self')

                    ul.rlist--inline.pull-right
                        li
                            a(href='#', data-db-target-for='actions-list', data-db-switch='rotate')
                                span Actions
                                i.icon-chevron-down(aria-hidden='true')

                            #actions-list.rlist.dropBlock__holder(data-db-target-of='actions-list')
                                .transplant.showit(data-target='.social-media' data-remove='false' data-toggle='transplant' data-direction='from' data-transplant='self')


