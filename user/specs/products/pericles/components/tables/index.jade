extends /specs/products/pericles/page-structure/structure/templates/structure/layout-tmpl.jade

block content
    include /specs/page-structure/helpers/print-json-mixin.jade
    include /specs/page-structure/helpers/print-js-code-mixin.jade


    section.source_section
        h2 Examples

        .source_example
            | !{pb.render('tables', 'default.json', {"shared": {"model": {"config": {"wrapper": "false"}}}})}


        h3 Bordered Table
        markdown
            p Add `separator` class to the table to add border between rows.

        .source_example
            | !{pb.render('tables', 'bordered.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["separator"]}}}})}

        h3 Expandable Table
        markdown
            p A table can be made expandable by adding the `expandable` class.
            p `expandable` class is used for styling and to attach JavaScript event handlers. When JavaScript is not enabled, the tables will be initialized as fully visible.
            p Each `td` in `tbody` must have a `data-thead` attribute (generated by the template from heading); it is then used to create title on smaller screens.
            p Use `unlabeled` class for table cells that should be unlabeled on mobile devices.

        .source_example
            | !{pb.render('tables', 'expandable.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["separator"]}}}})}


        h3 Checkbox Table
        markdown
            p Add `table-checkboxes` class for tables containing checkboxes.
        .source_example
            | !{pb.render('tables', 'checkbox.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["table-checkboxes"]}}}})}



        h3 Checkbox Expandable Table
        .source_example
            | !{pb.render('tables', 'checkbox-expandable.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["table-checkboxes", "separator"]}}}})}



        h3 Saved Search Tables
        markdown
            p Use `stacked` class for table to make the table cells act as DIV blocks with full width.
            p Use `action` class for table cells that should have `auto` width in `stacked` table.
        .source_example
            | !{pb.render('tables', 'saved-search.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["separator", "stacked", "unlabeled"]}}}})}

        | #{''}

