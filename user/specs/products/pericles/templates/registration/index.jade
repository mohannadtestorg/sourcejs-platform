                                .row
                                    .card.card--light-shadow.col-md-12
                                        form(action='/action/registration', method='post')
                                            input(type='hidden', name='source', value='')
                                            input(type='hidden', name='redirectUri', value='/')
                                            input(type='hidden', name='current', value='/action/registration')
                                            .pb-dropzone.formDropZone(data-pb-dropzone='formDropZone')
                                                h2
                                                    | Login information
                                                section.login-info
                                                    input(type='hidden', name='login.id', value='21b9f991-012b-4bfc-a9df-cc4543d35eaa')
                                                    input(type='hidden', name='section', value='login')
                                                    .row
                                                        .col-md-6
                                                            .input-group
                                                                .label
                                                                    label(for='login.email')
                                                                        | Email
                                                                        span *
                                                                        span.required-marker *
                                                                input.email(id='login.email', type='text', name='login.email', value='', size='15', placeholder='ex. user@institution.edu')
                                                            .input-group
                                                                .label
                                                                    label(for='login.email2')
                                                                        | Retype email
                                                                        span.required-marker *
                                                                input.email2(id='login.email2', type='text', name='login.email2', value='', size='15', placeholder='ex. user@institution.edu')
                                                            p.note
                                                                | A one-time confirmation e-mail will be sent to this address. Your e-mail will serve as your login.
                                                        .col-md-6
                                                            .input-group
                                                                .label
                                                                    label(for='login.password')
                                                                        | Password
                                                                        span *
                                                                        span.required-marker *
                                                                input.pass-hint(id='login.password', type='password', name='login.password', value='', autocomplete='off', placeholder='Type your password')
                                                                span.password-eye-icon.icon-eye.hidden
                                                                .password-strength-indicator(data-min='10', data-max='32', data-strength='3')
                                                                    span.text.too-short Too Short
                                                                    span.text.weak Weak
                                                                    span.text.medium Medium
                                                                    span.text.strong Strong
                                                                    span.text.very-strong Very Strong
                                                                    span.text.too-long Too Long
                                                            .input-group
                                                                .label
                                                                    label(for='login.password2')
                                                                        | Confirm Password
                                                                        span.required-marker *
                                                                input(id='login.password2', type='password', name='login.password2', value='', autocomplete='off', placeholder='Re-type your password')
                                                                span.password-eye-icon.icon-eye.hidden
                                                            p.note
                                                                | Must be at least 10 characters long, and contain at least three of following:
                                                                br
                                                                |  Lowercase letter (a-z) | Uppercase letter (A-Z) | Number (0-9) | Special Character
                                                hr.separator
