                    div(data-pb-dropzone='main')
                        .fullwidth-header.card.card--light-shadow(data-widget-def='ux3-layout-widget', data-widget-id='06ab8352-e2c4-416b-aee9-2b2b15c69e8b')
                            .container
                                .row
                                    div
                                        .gutterless.col-md-6.gutterless
                                            h1.account-page__header
                                                | Register as a new user
                                            div
                                        .col-md-6.gutterless
                        div(data-widget-def='ux3-layout-widget', data-widget-id='0f7bccba-8328-4dbd-a1fa-e84c526dd9ab')
