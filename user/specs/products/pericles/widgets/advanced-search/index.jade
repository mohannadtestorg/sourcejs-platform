extends /specs/products/pericles/page-structure/structure/templates/structure/layout-tmpl.jade

block content
    include /specs/page-structure/helpers/print-json-mixin.jade
    include /specs/page-structure/helpers/print-js-code-mixin.jade

    .source_info
        markdown
            p Styles changed based on <a href='https://jira.atypon.com/browse/LIT-194456' target="_blank">`LIT-194456`</a>


    section.source_section

        h2 Usage
        h3 Include template
        +printJsCode('include /widgets/advanced-search/templates/advanced-search/advanced-search-tmpl.jade')
        h3 Data
        p The following (or similar) data structure must exist to be able to use Advanced search widget.

        +printJson({
            "data": {
                "numOfDefaultSearchTerms": "1",
                "searchInDropdown": [
                    {
                        "label": "Anywhere",
                        "value": "AllField"
                    },
                    {
                        "label": "Title",
                        "value": "PubTitle"
                    },
                    {
                        "label": "Author",
                        "value": "Contrib"
                    },
                    {
                        "label": "Keywords",
                        "value": "Keyword"
                    }
                ],
                "searchIn": [
                    {
                        "searchTerm": "test",
                        "searchField": "AllField"
                    },
                    {
                        "searchTerm": "john",
                        "searchField": "Contrib"
                    }
                ],
                "filters": {
                    "ConceptID": {
                        "label": "Topic",
                        "placeholder": "e.g. Genetic Anomalies",
                        "data-id": "ConceptID",
                        "data-auto-complete-target": "topic"
                    },
                    "publication": {
                        "label": "Published in",
                        "placeholder": "e.g. Journal of Theoritical Biology",
                        "data-auto-complete-target": "Title"
                    },
                    "publicationDate": {
                        "label": "Publication Date",
                        "placeholder": "e.g. 2001-2005 or 11-2004",
                        "radioButtons": [
                            {
                                "anyDate": {
                                    "label": "All dates"
                                }
                            },
                            {
                                "staticRange": {
                                    "label": "Last: ",
                                    "staticRangeDropdown": [
                                        {
                                            "value": "20170313-20170413",
                                            "label": "month"
                                        },
                                        {
                                            "value": "20161013-20170413",
                                            "label": "6 months"
                                        },
                                        {
                                            "value": "20160413-20170413",
                                            "label": "year"
                                        }
                                    ]
                                }
                            }
                        ],
                        "timeFrame": {
                            "label": "Custom range: ",
                            "afterYear": {
                                "label": "From",
                                "fromDropDown": [
                                    "2016",
                                    "2015",
                                    "2014",
                                    "2013",
                                    "2012",
