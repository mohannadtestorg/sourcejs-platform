                                    "2005",
                                    "2004",
                                    "2003",
                                    "2002",
                                    "2001",
                                    "2000"
                                ]
                            }
                        }
                    }
                },
                "advancedFilters": [
                    {
                        "earlycite": {
                            "label": "Pre-print",
                            "value": "on"
                        }
                    },
                    {
                        "accessFilterRadioButtons": [
                            {
                                "label": "All content",
                                "id": "All content"
                            },
                            {
                                "label": "Open access content only",
                                "id": "openAccess",
