mixin coverParentItem(link, itemVloume, itemIssue)
    a.cover-image__parent-item(href=link)
        if (itemVloume)
            span.comma Volume #{itemVloume},&nbsp;
        if (itemIssue)
            | Issue #{itemIssue}


mixin coverCommonDetails(cover, date)
    if cover.pageRange
        .cover-image__pageRange
            label Pages:&nbsp;
            span !{cover.pageRange}
    if date
        .cover-image__date
            span !{date}

    if cover.editors
        .cover-image__editors
            case cover.type
                when 'Book'
                    label Editor(s)&nbsp;
                default
                    label Issue Edited by:&nbsp;
            span !{cover.editors}


mixin coverDetails(cover)
    block coverDetails
        if details
            .cover-image__details
                if thisWidget.properties.actions == 'slider'
                    case cover.type
                        when 'Issue'
                            if (cover.title)
                                a(href=cover.tocUrl)
                                    h2.cover-image__title !{cover.title}


                            if cover.issueLabel
                                h2.cover-label !{cover.issueLabel}

                            else if (cover.volume) || (cover.issue)
                                +coverParentItem(cover.tocUrl, cover.volume, cover.issue)

                            a(href=cover.tocUrl)
                                h2.cover-image__title !{cover.title}

                            if cover.issueText
                                p.cover-text !{cover.issueText}
                            else
                                +coverCommonDetails(cover, cover.coverDate)
                            if cover.coverImage
                                p.cover-image__desc !{cover.coverImage.caption}

                        when 'Book'
                            a(href=cover.bookUrl)
                                h2.cover-image__title !{cover.title}
                                    if (cover.edition)
