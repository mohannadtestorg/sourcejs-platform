mixin coverImage(cover, link, alt, className)
    div(class=className)
        - var imageSRC = !recent && (data.coverImage) && (data.coverImage.src) ? data.coverImage.src : cover.coverImage.src
        if (thisWidget.properties.actions == 'linkToLatestIssue' && coverParent && coverParent.latestIssue && coverParent.latestIssue.coverImage && coverParent.latestIssue.coverImage.src)
            - imageSRC = coverParent.latestIssue.coverImage.src ;
            - link = coverParent.latestIssue.tocUrl
        a(href=link title=alt)
            img(src=imageSRC alt=altValue)
    if thisWidget.properties.includeMetaData
        +coverDetails(cover)

mixin cover(cover, index)
    block coverCheckDetails
        if ((cover.coverDate) || (cover.pageRange) || (cover.issue) || (cover.volume) || (cover.serial) || (cover.latestIssue) || (cover.latestBook) || (cover.title) || (cover.issueLabel) || (cover.issueText) || (cover.type)) && thisWidget.properties.includeMetaData
            - details = true
            - imageClass = 'cover-image__image hasDetails'

    if thisWidget.properties.actions == 'nothing'
        block coverImage
            div(class=imageClass)
                img(src= !recent && (data.coverImage) && (data.coverImage.src) ? data.coverImage.src : cover.coverImage.src alt="Cover image")
            if thisWidget.properties.includeMetaData
                +coverDetails(cover)

    else if thisWidget.properties.actions == 'linkToIssueOrBook'
        block coverImageIssueOrBookLink
            if (cover.type)
                case cover.type
                    when 'Issue'
                        - altValue = "View Table of Contents for " + cover.serial.title + " volume "+cover.volume+" issue "+ cover.issue;
                        - linkUrl = cover.tocUrl;


                    when 'Book'
                        - altValue = "View Table of Contents for "+cover.title;
                        - linkUrl = cover.bookUrl;


                    when 'Journal'
                        - altValue = "View Table of Contents for "+cover.title;
                        - linkUrl = cover.latestIssue.tocUrl ;
                        if (coverParent && coverParent.latestIssue)
                            - linkUrl = coverParent.latestIssue.tocUrl ;

                    when 'BookSeries'
                        - altValue = "View Table of Contents for "+cover.title;
                        - linkUrl = cover.latestBook.bookUrl ;

                +coverImage(cover, linkUrl, altValue, imageClass)

    else if thisWidget.properties.actions == 'linkToLatestIssue'
        block coverImageIssueOrBookLink
            if (cover.type)
                case cover.type
                    when 'Issue'
                        - altValue = "View Table of Contents for " + cover.serial.title + " volume "+cover.volume+" issue "+ cover.issue;
                        - linkUrl = cover.tocUrl;
                        if (coverParent && coverParent.latestIssue)
                            - linkUrl = coverParent.latestIssue.tocUrl ;

                    when 'Book'
                        - altValue = "View Table of Contents for "+cover.title;
                        - linkUrl = cover.bookUrl;


                    when 'Journal'
                        - altValue = "View Table of Contents for "+cover.title;
                        - linkUrl = cover.latestIssue.tocUrl ;
                        if (coverParent && coverParent.latestIssue)
                            - linkUrl = coverParent.latestIssue.tocUrl ;

                    when 'BookSeries'
                        - altValue = "View Table of Contents for "+cover.title;
                        - linkUrl = cover.latestBook.bookUrl ;

                +coverImage(cover, linkUrl, altValue, imageClass)



    else if thisWidget.properties.actions == 'linkToSeriesHome'
        block coverImageSeriesLink
            if (cover.type)
                case cover.type
                    when 'Issue'
                        - altValue = "View Table of Contents for " + cover.serial.title + " volume "+cover.volume+" issue "+ cover.issue;
                        - linkUrl = cover.serial.journalUrl;

                    when 'Book'
                        - altValue = "View Table of Contents for "+cover.title;
                        - linkUrl = cover.bookUrl;

                    when 'Journal'
                        - altValue = "View Table of Contents for "+cover.title;
                        - linkUrl = cover.journalUrl;

                    when 'BookSeries'
                        - altValue = "View Table of Contents for "+cover.title;
                        - linkUrl = cover.bookSeriesURL;

                +coverImage(cover, linkUrl, altValue, imageClass)


    else if thisWidget.properties.actions == 'showCoverDetails'
        block coverImageDetails
            .base
                div(class=imageClass)
                    a(href="#" title="View details for " + cover.serial.serialTitle + " cover image" data-db-target-for=thisWidget.id + index)
                        img(src=!recent && (data.coverImage) && (data.coverImage.src) ? data.coverImage.src : cover.coverImage.src alt="View details for " + cover.serial.serialTitle + " cover image")
                if thisWidget.properties.includeMetaData
                    div.dropBlock__holder(data-db-target-of=thisWidget.id+ index)
                        +coverDetails(cover)


    else if thisWidget.properties.actions == 'showLargeCover'
        block coverImageLarge
            figure.figure
                img.figure__image(src=cover.coverImage.src alt="View large " + cover.serial.serialTitle + " cover image")
                if thisWidget.properties.includeMetaData
                    figcaption
                        .figure__caption
                            +coverDetails(cover)
                    | !{pb.render('figure-viewer', 'pericles')}



mixin coverTmpl(covers, recent)
    if (covers)
        if thisWidget.properties.actions == 'slider'
            .tab
                ul.rlist.loc.tab__nav.swipe__list(role='tablist')
                    each cover, l in covers
                        li.cover-image(role='presentation')
                            a(id='coverPane-' + l + thisWidget.properties.id + 'con' href='#coverPane-' + l + thisWidget.properties.id aria-controls='#coverPane-' + l + thisWidget.properties.id role='tab' data-toggle='tab' aria-selected='false')
                                img(src=cover.coverImage.src, alt=cover.title )

                if thisWidget.properties.includeMetaData
                    ul.rlist.tab__content(role="tablist")
                        each cover, l in covers
                            li.tab__pane(id='coverPane-' + l + thisWidget.properties.id aria-labelledby='coverPane-' + l + thisWidget.properties.id + 'con', role='tab')

                                if (cover.coverDate) || (cover.issue) || (cover.volume) || (cover.serial) || (cover.latestIssue) || (cover.latestBook) || (cover.pageRange) || (cover.issueLabel) || (cover.issueText)
                                    - details = true
                                    - imageClass = 'cover-image__image hasDetails'

                                +coverDetails(cover)

        else
            ul.rlist.loc
                each cover, l in covers
                    li.grid-item.cover-image(class= thisWidget.properties.actions == 'linkToLatestIssue' ? 'cover-image__latestIssue' : '')
                        +cover(cover, l)

mixin coverRecentTmpl(covers, recent)
    if (covers)
        if thisWidget.properties.actions == 'slider'
            .tab
                ul.rlist.loc.tab__nav.swipe__list(role='tablist')
                    each cover, m in covers
                        - coverParent = cover;
                        each recent, l in cover.recent
                            li.cover-image(role='presentation')
                                a(id='coverPane-' + m + thisWidget.properties.id + 'con' href='#coverPane-' + m + thisWidget.properties.id aria-controls='#coverPane-' + m + thisWidget.properties.id role='tab' data-toggle='tab' aria-selected='false')
                                    if (recent.coverImage) && (recent.coverImage.src)
                                        img(src=recent.coverImage.src, alt=recent.title )


                if thisWidget.properties.includeMetaData
                    ul.rlist.tab__content(role="tablist")
                        each cover, m in covers
                            - coverParent = cover;
                            each recent, l in cover.recent
                                li.tab__pane(id='coverPane-' + m + thisWidget.properties.id aria-labelledby='coverPane-' + m + thisWidget.properties.id + 'con', role='tab')

                                    if (recent.coverDate) || (recent.issue) || (recent.volume) || (recent.serial) || (recent.latestIssue) || (recent.latestBook) || (recent.pageRange) || (recent.issueLabel) || (recent.issueText)
                                        - details = true
                                        - imageClass = 'cover-image__image hasDetails'

                                    +coverDetails(recent)

        else
            ul.rlist.loc.mostRecent
                each cover, m in covers
                    - coverParent = cover;
                    each recent, m in cover.recent
                        li.grid-item.cover-image(class= thisWidget.properties.actions == 'linkToLatestIssue' ? 'cover-image__latestIssue' : '')
                            +cover(recent, m)


block coverImageMain
    if (data) && (data.single)
        - covers = data.single
        if thisWidget.properties.mostRecentCover && thisWidget.properties.numberOfCoverToDisplay > 0
            -recent = true;
            +coverRecentTmpl(covers, recent)

        else
            -recent = false;
            +coverTmpl(covers, recent)

        if thisWidget.properties.MoreLink
            a.more-widget-link(href=thisWidget.properties.moreLinkUrl) !{thisWidget.properties.moreLinkLable}