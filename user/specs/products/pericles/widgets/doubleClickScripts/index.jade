extends /specs/products/pericles/page-structure/structure/templates/structure/layout-tmpl.jade

block content
    include ../../../../page-structure/helpers/print-json-mixin.jade
    include ../../../../page-structure/helpers/print-js-code-mixin.jade

    h1 Double Click scripts


    .source_info
        markdown
            p This widget used to add analytics digital data to the page header

    section.source_section
        h2 Usage
        h3 Include template
        +printJsCode('include /specs/products/pericles/widgets/doubleClickScripts/templates/doubleClickScripts/doubleClickScripts-tmpl.jade')
        h3 Data
        markdown
            p The following data structure must exist to be able to use the widget.

        +printJson({
            "data": {
                "journal": {
                    "zoneTags": [
                        {
                            "uri": "ms"
                        }
                    ],
                    "siteTags": [
                        {
                            "uri": "ms"
                        }
                    ]
                }
            }
        })

    section.source_section
        .source_example
            .container
                | !{pb.render('doubleClickScripts', 'data.json', 'pericles')}
    | #{''}
