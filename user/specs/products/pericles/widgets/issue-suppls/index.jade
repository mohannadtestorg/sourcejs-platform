extends /specs/products/pericles/page-structure/structure/templates/structure/layout-tmpl.jade



block content

    include /specs/page-structure/helpers/print-json-mixin.jade
    include /specs/page-structure/helpers/print-js-code-mixin.jade

    h1 Issue Supplementary Files

    section.source_section
        h2 Usage
        h3 Include template
        +printJsCode('include /widgets/issue-suppls/templates/issue-suppls/issue-suppls-tmpl.jade')
        h3 Data
        p The following data structure must exist to be able to use Issue Supplementary Files template.
        h3 Single Cover
        +printJson({
            "data": {
                "supplContent": {
                    "description": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Biologists define and describe organisms by their traits, and through \nthe ecological and evolutionary consequences of those traits. As we \nenter an era dominated by rapid evolution in response to \nanthropogenically caused environmental change, understanding the \nfunctional significance of traits – how, through facilitation and \nconstraint, they determine performance in the adaptive landscape – is an\n imperative charge of evolutionary biology, and one that <em>Functional Ecology</em> actively serves.</div>",
                    "editors": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><strong>Edited by Scott Carroll</strong></div>",
                    "coverCaption": "TEST CAPTION"
                }
            }
        })



    section.source_section
        h2 example

        .source_example
            .container
                | !{pb.render('issue-suppls', 'content.json', 'pericles')}
    | #{''}

