extends ../../../../../../../ux3/components/tabs/templates/tabs/tabs-tmpl.jade

block tabsPrefix
    - var thisWidget = tabsData.thisWidget;
    - var data = tabsData;


mixin tablinkloi(item,l)
    a(href="#pane-" + thisWidget.id + l + tabNumber aria-controls="#pane-" + thisWidget.id + l + tabNumber role="tab" data-toggle="tab" data-expand=item.label title=item.label id="pane-" + thisWidget.id + l + tabNumber + "con")
        +item(item)


block tabsLinks
    if (item.content)
        if data.expandFirst && l == 0
            each childItem, m in item.content
                li
                    +tablinkloi(childItem,m)
        else
            div.expandable-list
                a.expandable-list__toggle(href='#' data-toggle='dropdown' data-expand=item.label aria-expanded="false" aria-controls=item.label title=item.label)
                    i.icon-add_box(aria-hidden='true')
                    +item(item)
                ul.rlist.expandable-list__body(id=item.label aria-hidden='true')
                    each childItem, m in item.content
                        li
                            +tablinkloi(childItem,m)
    else
        +tablinkloi(item,l)


mixin loi(vol, items)
    block loIssues
        ul.rlist.loi__issues
            if (items)
                each item, l in items
                    li.card.clearfix
                        div.item__image
                            a(href=item.url title="go to " + item.title)
                                if item.coverImage
                                    img(src="//:0" data-src=item.coverImage title="cover Image of " + item.title  alt="")
                                else
                                    div.item__default__image
                                        i.item__default__icon.icon-sort(aria-hidden="true")
                        div.loi__issue
                            if (item.access)
                                if item.access == 'FULL_ACCESS'
                                    .doi-access-wrapper
                                        .access-type.full-access
                                            i.icon-icon-lock_open(aria-hidden='true')
                                            .doi-access Full access
                                else if item.access == 'OPEN_ACCESS'
                                    .doi-access-wrapper
                                        .access-type.open-access
                                            i.icon-icon-lock_open(aria-hidden='true')
                                            .doi-access Open access
                                else if item.access == 'FREE_ACCESS'
                                    .doi-access-wrapper
                                        .access-type.free-access
                                            i.icon-icon-lock_open(aria-hidden='true')
                                            .doi-access free access


                            if (vol.VolNo) && (item.issue)
                                h4.parent-item
                                    a(href=item.url title="go to " + item.title) Volume !{vol.VolNo}, Issue !{item.issue}

                            if (item.title)
                                h4.issue-title !{item.title}
                            if (item.pageRange)
                                .iPageRange
                                    label Pages:&nbsp;
                                    | !{item.pageRange}
                            if (item.coverDate)
                                .coverDate
                                    label
                                        span.cover-date-value !{item.coverDate}



block tabsPanes
    - tabNumber = 1;
    div.tab__content
        a(href='#').back-btn
            i.icon-arrow_l
            | Back to dates
        h2.is-accessible Issues
        ul.rlist(role="tablist")
            each item, I in data.content
                if (item.content)
                    - tabNumber++;
                    each childItem, m in item.content
                        li.tab__pane(id="pane-" + thisWidget.id + m + tabNumber aria-labelledby="pane-" + thisWidget.id + m + tabNumber + "con" role="tab")
                            if (childItem.volumes)
                                each vol, l in childItem.volumes
                                    h3.intro !{childItem.year} - Volume !{vol.VolNo}
                                        span.journalTitle , !{data.journalTitle}
                                    +loi(vol, vol.issues)
                else
                    li.tab__pane(id="pane-" + thisWidget.id + I + tabNumber aria-labelledby="pane-" + thisWidget.id + I + tabNumber + "con" role="tab")
                        if (item.volumes)
                            each vol, l in item.volumes
                                h3.intro !{item.label} - Volume !{vol.VolNo}
                                    span.journalTitle , !{data.journalTitle}
                                +loi(vol, vol.issues)




block tabsMain
    div.loi.tab.tab--aside
        - tabNumber++;
        ul.rlist.loi__list.tab__nav(role="tablist")
            h2.side-section-header
                span.is-accessible Filter issues by&nbsp;
                | Issue archive
            +nav()
        +pane()




block tabsNav
    - var l = 0;
    if (data) && (data.content)
        each item, k in data.content
            if data.expandFirst && k == 0
                if (item.content)
                    -tabNumber++
                +link(item,l)
                - l++;
            else
                li(class=item.content ? 'nested' : '')
                    if (item.content)
                        -tabNumber++
                    +link(item,l)
                    - l++;



block tabsItem
    if (item.label)
        span.loi-tab-item !{item.label}
            if (item.volumes)

                - var itemNo = item.volumes.length

                | !{ " - Volume "}
                if (itemNo > 1)
                    each vol, l in item.volumes

                        if l == 0
                            span.pull-right
                                | !{ " - " + vol.VolNo}
                        else if l == (itemNo - 1)
                            | !{vol.VolNo}

                else
                    | !{item.volumes[0].VolNo}

    else if (item.year)
        span.loi-tab-item !{item.year}
            if (item.volumes)
                - var itemNo = item.volumes.length

                | !{ " - Volume "}
                if (itemNo > 1)
                    each vol, l in item.volumes

                        if l == 0
                            span.pull-right
                                | !{ " - " + vol.VolNo}
                        else if l == (itemNo - 1)
                            | !{vol.VolNo}

                else
                    | !{item.volumes[0].VolNo}



