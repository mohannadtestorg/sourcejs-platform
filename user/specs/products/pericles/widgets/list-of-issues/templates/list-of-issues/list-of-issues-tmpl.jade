- data.loi.thisWidget = thisWidget;

block loi
    if (data.loi)
        div(id=thisWidget.id data-grouptype=data.loi.groupType)
            - var tabsData = {tabsData: data.loi};
            block loitabs
                | !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs", tabsData, 'pericles')}