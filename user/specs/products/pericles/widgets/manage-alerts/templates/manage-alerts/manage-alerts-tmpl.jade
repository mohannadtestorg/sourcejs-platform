extends ../../../../../../ux3/widgets/manage-alerts/templates/manage-alerts/manage-alerts-tmpl.jade

block alertWrapperClassBlock
    -var alertWrapperClass = 'alerts card '

block mobileDropdownBlock
    -var mobileDropdown = "none"


block topicalAlertLabel
    - var topicAlertsLabel = 'Topic Alerts'
    if (thisWidget.properties.displayTopicalAlert) && (thisWidget.properties.topicAlertsLabel)
        - var topicAlertsLabel = thisWidget.properties.topicAlertsLabel

    | !{topicAlertsLabel}

block newContentAlert
    | !{pb.render("manage-alerts", "alerts/new-content", {data: data,thisWidget:thisWidget}, 'pericles')}

block citationAlert
    | !{pb.render("manage-alerts", "alerts/citation", {data: data,thisWidget:thisWidget}, 'pericles')}

block topicsAlert
    | !{pb.render("manage-alerts", "alerts/topical", {data: data, thisWidget:thisWidget}, 'pericles')}