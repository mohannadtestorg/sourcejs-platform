                "pages": 18,
                "actionUrl": "http://mhamdan:18080/action/showArticleSelect?institutionUserId=1059",
                "users": [
                    {
                        "givenName": "Mabvuto",
                        "surname": "Hardy",
                        "email": "mhardy@atypon.com"
                    },
                    {
                        "givenName": "Mohammad",
                        "surname": "Hijazi",
                        "email": "mhijazi@atypon.com"
                    }
