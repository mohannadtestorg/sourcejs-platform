extends /specs/products/pericles/page-structure/structure/templates/structure/layout-tmpl.jade
block content
    include /specs/page-structure/helpers/print-json-mixin.jade
    include /specs/page-structure/helpers/print-js-code-mixin.jade

    section.source_section
        h2 Usage
        h3 Include template
        +printJsCode('include /widgets/personal-information/templates/personal-information/personal-information-tmpl.jade')
        markdown
            p The following data structure must exist to be able to use Personal Information template.
        +printJson({
            "data": {
                "surname": {
                    "hidden": false,
                    "value": "Abu Emiesh",
                    "required": true
                },
                "givenNames": {
                    "hidden": false,
                    "message": "Alphanumeric characters, hyphens, single quotes, space and dot only",
                    "value": "Hamzeh",
                    "required": true
                },
                "title": {
                    "hidden": true,
                    "value": "Mr",
                    "required": false
                }
            }
        }
        )



    section.source_section
        h2 Example


        .source_example
            .container
                | !{pb.render('personal-information', 'data.json', 'pericles')}


    | #{''}


