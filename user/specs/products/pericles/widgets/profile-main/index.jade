extends /specs/products/pericles/page-structure/structure/templates/structure/layout-tmpl.jade

block content

    section.source_section
        include /specs/page-structure/helpers/print-json-mixin.jade
        include /specs/page-structure/helpers/print-js-code-mixin.jade


    section.source_section
        h2 Profile Main widget
        h3 Include template
        +printJsCode('include /specs/ux3/widgets/profile-main/templates/profile-main/profile-main-tmpl.jade')
        h3 Data
        p The following data structure must exist to be able to use Profile Main widget.
        +printJson(            {
            "data": {
                "displayInstitutionsAsDropDownList": "true",
                "numberOfInstitutions": "",
                "institutions": {
                    "label": "Select an Institution",
                    "options": [
                        {
                            "label": "",
                            "value": "",
                            "selected": ""
                        }
                    ]
                }
            }
        })
    | #{''}

    section.source_section
        h2 Profile Main select
        .source_example
            | !{pb.render('profile-main', 'profile-main.json', 'pericles')}

    section.source_section
        h2 Profile Main list
        .source_example
            | !{pb.render('profile-main', 'profile-main-list.json', 'pericles')}
    | #{''}




