extends /specs/products/pericles/page-structure/structure/templates/structure/layout-tmpl.jade

block content

    .source_info
        markdown
            p Styles changed to match the <a href="https://projects.invisionapp.com/d/main#/console/12228601/258969282/inspect"> new design</a>
    section.source_section
        include /specs/page-structure/helpers/print-json-mixin.jade
        include /specs/page-structure/helpers/print-js-code-mixin.jade

        h2 Usage
        h3 Include template
        +printJsCode('include /specs/ux3/widgets/publication-versions/templates/publication-versions/publication-versions-tmpl.jade')
        h3 Data
        markdown
            p The following data structure must exist to be able to use Publication - Versions template.
        +printJson({
            "data": {
                "items": [
                    {
                        "contentType": "Article",
                        "title": "Bridge Column Maximum Drift Estimation via Computer Vision",
                        "tocHeading": "Technical Papers",
                        "best": "/doi/full/10.1061/%28ASCE%29CP.1943-5487.0000527",
                        "epubDate": "September 2015",
                        "contribs": "<ul class=\"rlist--inline loa comma\" style=\"float: none;position: static;\" aria-label=\"authors\"><li><a href=\"/author/search/url?q=Nick Gayeski\" title=\"Nick Gayeski\"><span>Nick Gayeski</span></a></li><li><a href=\"/author/search/url?q=George Pess\" title=\"George Pess\"><span>George Pess</span></a></li><li><a href=\"/author/search/url?q=Tim Beechie\" title=\"Tim Beechie\"><span>Tim Beechie</span></a></li></ul>",
                        "group": {
                            "contentType": "Issue",
                            "issue": "4",
                            "volume": "30",
                            "issueType": "NORMAL",
                            "isAheadOfPrint": false,
                            "isJustAccepted": false,
                            "isForthcoming": false,
                            "coverDate": "July 2016",
                            "tocLink": "/toc/jccee5/30/4",
                            "serial": {
                                "title": "Journal of Computing in Civil Engineering",
                                "journalLink": "/action/showJournal?doi=10.1061%2Fjccee5",
                                "code": "jccee5"
                            }
                        }
                    }
                ]
            },
            "errors": []
        })
    | #{''}


    section.source_section
        h2 Examples

        h3 publication Versions
        .source_example
            | !{pb.render('publication-versions', 'publication-versions.json', 'pericles')}


        h3 publication Versions - that has newer versions
        .source_example
            | !{pb.render('publication-versions', 'hasnewer.json', 'pericles')}

    | #{''}

