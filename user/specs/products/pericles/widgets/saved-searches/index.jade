extends /specs/products/pericles/page-structure/structure/templates/structure/layout-tmpl.jade

block content

    h1 Saved searches

    .source_info
        markdown
            p Styles changes based on <a href='https://jira.atypon.com/browse/LIT-200288' target="_blank">`LIT-200288`</a>

    section.source_section

        include ../../../../page-structure/helpers/print-json-mixin.jade
        include ../../../../page-structure/helpers/print-js-code-mixin.jade

        h2 Usage
        h3 Data
        markdown
            p The following data structure must exist to be able to use this template.
        +printJson({
            "data": {
                "noSearchesMessage": "You do not have any saved searches",
                "searches": [
                    {
                        "queryName": "test2",
                        "frequency": "D",
                        "savedDate": "Nov 15, 2017",
                        "runDate": "Nov 15, 2017",
                        "runUrl": "/action/doSearch?target\u003dsaved\u0026runSaved\u003d68",
                        "deleteUrl": "/action/doDeleteSearch?queryId\u003d68\u0026searchType\u003dsaved"
                    },
                    {
                        "queryName": "test",
                        "frequency": "N",
                        "savedDate": "Nov 15, 2017",
                        "runDate": "Nov 15, 2017",
                        "runUrl": "/action/doSearch?target\u003dsaved\u0026runSaved\u003d67",
                        "deleteUrl": "/action/doDeleteSearch?queryId\u003d67\u0026searchType\u003dsaved"
                    },
                    {
                        "queryName": "test3",
                        "frequency": "W",
                        "savedDate": "Nov 15, 2017",
                        "runDate": "Nov 15, 2017",
                        "runUrl": "/action/doSearch?target\u003dsaved\u0026runSaved\u003d67",
                        "deleteUrl": "/action/doDeleteSearch?queryId\u003d67\u0026searchType\u003dsaved"
                    }
                ],
                "properties": {
                    "displaySavedOn": true,
                    "displayLastRunOn": true,
                    "numberOfSearchesToDisplay": "5"
                }
            }

        })
    section.source_section
        h2 Examples


        h3 No saved searches
        .source_example
            | !{pb.render('saved-searches', 'example-2.json', 'pericles')}

        h3 Saved searches
        .source_example
            | !{pb.render('saved-searches', 'example.json', 'pericles')}


    | #{''}

