extends /specs/products/pericles/page-structure/structure/templates/structure/layout-tmpl.jade

block content

    section.source_section
        include ../../../../page-structure/helpers/print-json-mixin.jade
        include ../../../../page-structure/helpers/print-js-code-mixin.jade

        h2 Usage
        h3 Include template
        +printJsCode('include /specs/ux3/widgets/search-facets/templates/search-facets/search-facets-tmpl.jade')
        h3 Data
        p The following (or similar) data structure must exist to be able to use Defined list template.

        +printJson({

            "data": {
                "appliedFacets": [
                    {
                        "label": "Biology",
                        "link": ""
                    }
                ],
                "facets": [
                    {
                        "type": "alphabetRange",
                        "title": "Alphanumeric",
                        "values": [
                            {
                                "label": "A",
                                "link": "#",
                                "used": true
                            }
                        ]
                    },
                    {
                        "type": "Ppub",
                        "title": "Publication Date",
                        "style": "slider",
                        "values": "?",
                        "maxDate": "2017",
                        "minDate": "2000"
                    },
                    {
                        "type": "Taxonomy",
                        "values": [
                            {
                                "label": "Technical Topics",
                                "link": "#",
                                "count": 36,
                                "values": [
                                    {
                                        "label": "Biology",
                                        "link": "#",
                                        "count": 7
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "ContribStored",
                        "title": "Authors",
                        "more": 95,
                        "values": [
                            {
                                "label": "Martinez, Fernando J",
                                "link": "#",
                                "count": 167
                            }
                        ]
                    }
                ]
            }


        })

        p In the above example we are using <a href="../../components/facet/"><strong>Facet</strong></a>, <a href="../../components/facet-date/"><strong>Facet Date</strong></a> ,  <a href="../../components/alphanumeric/"><strong>Alphanumeric</strong></a>
            |and <a href="../../components/applied-facets/"><strong>Applied Facets</strong></a> components.
    | #{''}

    section.source_section
        h2 Examples

        markdown
            small note: we have two options for the subjects section, either display all links or display only first five and hide the reset under the more toggle list 'default behavior for non-taxonomy sections', you can choose the option you'd like to use by setting the widget property `displayAll`

        h3 Search facets - display all taxonomy
        .source_example
            .container
                | !{pb.render('search-facets', 'displayAll.json', 'pericles')}

        h3 Search facets - dont display all taxonomy
        .source_example
            .container
                | !{pb.render('search-facets', 'facet.json', 'pericles')}


        h3 MRW Facet
        markdown
            p You have to set the widget property `hideSiblingTaxonomyNodes` to true, to use the mrw style
        .source_example
            .container
                | !{pb.render('search-facets', 'mrw.json', 'pericles')}

        h3 Browse Facet
        .source_example
            .container
                | !{pb.render('search-facets', 'browse.json', 'pericles')}


        h3 Virtual issue Facet
        markdown
            p we are using the alternative template `alt-search-facets`
        .source_example
            .container
                | !{pb.render('search-facets', 'search-facets/alternative/alt-search-facets','virtual-facet.json', 'pericles')}


    | #{''}

