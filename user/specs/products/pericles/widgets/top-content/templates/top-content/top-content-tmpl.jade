block topContentBody
    div.top-content
        if (data.items)
            | !{pb.render('top-content', 'top-content/extended/ext-issue-item', {data: data}, 'pericles')}
        if (data.widget) && (data.widget.moreUrl)
            a.more-link(href=data.widget.moreUrl)
                if (data.widget) && (data.widget.moreText)
                    | !{data.widget.moreText}
                else
                    | Show More