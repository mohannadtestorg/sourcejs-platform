div.editor-in-chief.publication-box.card.hidden-lg.hidden-md
    label Editor-in-Chief
    h3.author Willis K. Samson
    div.accordion
        a.accordion__control(href="#" , aria-expanded="false")
            span more
            i.icon-section_arrow_d
        div.accordion__content
            ul.rlist.editor-info
                li
                    a(href="#")
                        i.icon-Icon_Information
                        span Information for Authors
                li
                    a(href="#")
                        i.icon-Icon_mail
                        span Sign up for TOC alerts
                li
                    ul.rlist.social-icons
                        li
                            a(href="#")
                                i.icon-twitter
                                span Twitter
                        li
                            a(href="#")
                                i.icon-facebook
                                span Facebook
                        li
                            a(href="#")
                                i.icon-Rss
                                span RSS Feed
                        li
                            a(href="#")
                                i.icon-linkedin
                                span LinkedIn