extends /specs/products/physio/page-structure/structure/templates/structure/layout-tmpl.jade



block content

    h1 Search Result page
    section.source_section
        h2 Search Result page
        markdown
        code.src-html
        .source_example
            | !{data.header}
            main.content.search-page.pageBody
                .quickSearchRegion
                    .container
                        .row
                            div.col-lg-12.clearfix
                                | !{data.quickSearch}
                .search-page__result
                    .container
                        .row
                            .col-sm-4
                                #filter.hidden-xs.hidden-sm.search__filters
                                    each facet, l in data.facet
                                        | !{facet}
                            .col-sm-8.generic-tabs
                                | !{data.searchresult}



            | !{data.footer}
    | #{''}