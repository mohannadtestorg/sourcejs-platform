block loiPrefix
    - var order = "ascending";
    - if (data.order == "descending") order = "descending"

block loi
    if (data.ajaxRequest)
        | !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs-new-alt-latest-vol", {originaldata: data} , 'physio')}
    else
        div.loi-wrapper.loi-covers(data-widget-id=thisWidget.id data-order= order data-journal-doi= data.loi.journalDoi data-grouptype=data.loi.groupType )
            if (data.loi)
                div(id=thisWidget.id data-grouptype=data.loi.groupType)
                    block loitabs
                        | !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs-new-alt-latest-vol",  {tabsData: data, thisWidget:thisWidget} , 'physio')}