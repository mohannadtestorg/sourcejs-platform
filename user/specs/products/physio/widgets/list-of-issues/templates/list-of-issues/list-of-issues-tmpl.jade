extends  ../../../../../../ux3/widgets/list-of-issues/templates/list-of-issues/list-of-issues-tmpl.jade
block loiPrefix
    - data.loi.thisWidget = thisWidget;
    - var order = "ascending";
    - if (data.order == "descending") order = "descending"

block loi
    if (data.ajaxRequest)
        !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs", {originaldata: data}, 'physio')}
    else if (data.collapsible == false)
        div.loi-wrapper.uncollapsible(data-db-parent-of=thisWidget.id data-order= order data-journal-doi= data.loi.journalDoi )
            div.loi__banner
                div.dropBlock__holder.dropBlock-loi__holder(id=thisWidget.id data-grouptype=data.loi.groupType)
                    block loitabsUncollapse
                        | !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs", {originaldata: data}, 'physio')}
    else
        div.loi-wrapper(data-db-parent-of=thisWidget.id data-order= order data-journal-doi= data.loi.journalDoi )
            div.loi__banner
                div.loi__banner-list
                    if (data.nav)
                        #loi-banner.hidden-sm.hidden-xs.pull-left
                            each item, k in data.nav
                                if k == 'archive'
                                    a.w-slide__btn(class='loi__' + k href=item.href title=item.label data-db-target-for=thisWidget.id data-slide-target= '#'+ thisWidget.id data-slide-clone='self')
                                        if (item.label)
                                            | !{item.label}

                                else if k == 'additionalLinksData'
                                    each link, l in item
                                        if link.enabled == 'on'
                                            a(class='loi__additionalLink' href=link.url title=link.label)
                                                if (link.label)
                                                    | !{link.label}

                                else
                                    if (item.href)
                                        a(class='loi__' + k href=item.href title=item.label)
                                            if (item.label)
                                                | !{item.label}

                    .loi__banner__right-side.pull-right
                        block loiBannerSecond
                            | !{pb.renderDropzone(thisWidget, "coolbarDropZone")}


                if (data.loi)
                    div.dropBlock__holder.dropBlock-loi__holder(id=thisWidget.id data-db-target-of=thisWidget.id data-grouptype=data.loi.groupType)
                        block loitabs
                            | !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs", {originaldata: data}, 'physio')}
