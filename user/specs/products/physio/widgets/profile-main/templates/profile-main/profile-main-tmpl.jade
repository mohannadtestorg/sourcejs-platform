.clearfix.institutionListBlock
    if data.institutionList
        - var optionsNo = data.institutionList.length;

    if ((data.displayInstitutionsAsDropDownList == true) && (optionsNo > 1))
        .pull-right
            if (data.institutionList)
                .pull-left.profile-main__label
                    label Select an Institution
                .pull-right
                    select#institutionList(class="jcf")
                        option(value='#') Select
                        each item, I in data.institutionList
                            if(item.InstitutionName)
                              option(value=item.InstitutionUrl) !{item.InstitutionName}
    else
        .pull-right
            if (data.institutionList)
                ul.rlist.profile-main__list
                    each item, I in data.institutionList
                        li
                            if(item.InstitutionUrl)
                              a(href=item.InstitutionUrl) !{item.InstitutionName}