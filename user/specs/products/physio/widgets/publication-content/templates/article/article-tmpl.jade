extends ../../../../../../ux3/widgets/publication-content/templates/article/article-tmpl.jade
include ./map/map-article-tmpl.jade

block article
    if(data.item.mathJax && data.item.mathJax.enabled)
        article.container(data-figures=data.item.figures data-references=data.item.references data-enable-mathjax=data.item.mathJax.enabled)
            +articleRow()
    else
        article.container(data-figures=data.item.figures data-references=data.item.references)
            +articleRow()

mixin articleAccordions(original)
    - var hasCorrectionOrRetraction = 0; // Assume there is no correction or retraction
    div
        ul.rlist--inline.article__header__accordions
            if (original.item && original.item.related && original.item.related.items)
                each item, i in original.item.related.items
                    if (item.rel_type === "erratum" || item.rel_type === "retraction")
                        - var p = hasCorrectionOrRetraction++;
                if(hasCorrectionOrRetraction > 1)
                    li.accordion.corrections
                        a(href="#" title="Open corrections" aria-controls="articleCorrections" class="corrections__ctrl accordion__control w-slide__btn article__header__accordions__ctrl "  data-slide-target="#articleCorrections" )
                                i(aria-hidden="true", class="icon-Icon_Information article__header__accordions__icon")
                                span.article__header__accordions__label Original articles
                                i.icon-section_arrow_d(aria-hidden='true')
                        ul.rlist.corrections__content.accordion__content(id="articleCorrections")
                            each item, i in original.item.related.items
                                if (item.rel_type === "erratum" || item.rel_type === "retraction")
                                    li
                                        a(href=item.url)
                                            span !{item.articleTitle}
                else
                    li.corrections.single
                        each item, i in original.item.related.items
                            if (item.rel_type == "erratum" || item.rel_type == "retraction")
                                a(href=item.url)
                                    i(aria-hidden="true", class="icon-Icon_Information")
                                    span !{item.label}
            if (original.item && original.item.alternateArticleVersion) && (original.item && original.item.alternateArticleVersion.version == "latest")
                li.latest-version(class=hasCorrectionOrRetraction > 1 ? "left-aligned" : "" || hasCorrectionOrRetraction == 0 ? "no-border" : "" )
                    div.versions-ctrl
                        if(original.item.alternateArticleVersion.abstractUrl)
                            a(href=original.item.alternateArticleVersion.abstractUrl)
                                | This is the final version - click for previous version
            if (original.item && original.item.alternateArticleVersion) && (original.item && original.item.alternateArticleVersion.version == "earliest")
                li.latest-version(class=hasCorrectionOrRetraction > 1 ? "left-aligned" : "" || hasCorrectionOrRetraction == 0 ? "no-border" : "")
                    div.versions-ctrl
                        if(original.item.alternateArticleVersion.abstractUrl)
                            a(href=original.item.alternateArticleVersion.abstractUrl)
                                | This is an earlier version - click for final version

block articleRow
    .row
        .col-sm-8.col-md-8.article__content
            include ./extended/ext-citation-tmpl
            +epub()
            +articleAccordions(original)
            //+articleCoolbar()
            include ./extended/ext-coolbar-tmpl
            div
                +articleBody()
            block articleDropZone
                | !{pb.renderDropzone(thisWidget, "articleBottomDropZone")}
        .col-sm-4.hidden-xs.hidden-sm.sticko__parent.article-row-right.gutterless
            //+articleTab()
            include ./extended/ext-tabs-tmpl

block ePubDate
    span.epub-section__item
        span.epub-section__state Published Online:
        if (data.item && data.item.alternateArticleVersion) && (data.item && data.item.alternateArticleVersion.version == "earliest")
            span.epub-section__date !{data.item.alternateArticleVersion.publicationDate}
        else
            span.epub-section__date !{data.item.ePubDate}