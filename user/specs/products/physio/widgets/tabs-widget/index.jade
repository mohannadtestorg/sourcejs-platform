extends /specs/products/physio/page-structure/structure/templates/structure/layout-tmpl.jade

block content
    include /specs/page-structure/helpers/print-json-mixin.jade
    include /specs/page-structure/helpers/print-js-code-mixin.jade
    section.source_section
       h3 Usage
       p Tabs widget is using #[a(href="/specs/ux3/components/tabs/") Tabs] template in component and it uses #[a(href="/specs/products/fum/widgets/render-inline/") pb.render] to render those tabs.

       h3 Date
       p The following the JSON structure Provided by the Front-end:
           +printJson({
               "data": {
                   "widget": {
                       "type": "flex",
                       "dynamic": false,
                       "hideEmpty": false,
                       "altBehavior": true,
                       "effect": "slide",
                       "vPort": "medium",
                       "id": "m1x",
                       "tabIds": [
                           "pane-m1x0con",
                           null,
                           "pane-m1x1con",
                           "pane-m1x2con"
                       ],
                       "tabLabels": [
                           "Figures",
                           "Access",
                           "References",
                           "Related"
                       ],
                       "tabClasses": [
                           "icon-shoppingcart",
                           "icon-permissions",
                           "icon-search",
                           "icon-profile_empty"
                       ],
                       "tabUrls": [
                           null,
                           "/home",
                           null,
                           null
                       ]
                   }
               },
               "errors": []
           })

           p For more details about tabs please visit #[a(href="/specs/ux3/components/tabs/") Tabs components].

    | #{''}

    section.source_section
           h2 Examples
           h3 Default Tabs
           .source_example
                   | !{data.proof}

           h3 Generic Tabs
           p  use class `generic-tabs` to make style of generic tabs
           .source_example.generic-tabs
                     | !{data.proof}

