if(data.items && data.items.length >0)
    each item, l in data.items
        div.featured__container
            if (item.group.coverImage)
                div.featured__cover
                    img(src=item.group.coverImage.src)
            div.info-container
                div.featured__date
                    i.icon-date
                    | !{item.epubDate}
                div.featured__title
                    a(href=item.best)
                        | !{item.title}
else
    p There are no articles to display at this time.