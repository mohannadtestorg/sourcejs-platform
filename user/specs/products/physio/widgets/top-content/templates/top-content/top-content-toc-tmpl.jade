if (data && data.items && data.items.length >0)
    each item, l in data.items
        div.top-list__container
            div.meta-container
                div.top-list__date
                    i.icon-date
                    | !{item.epubDate}
                div.top-list__title
                    a(href=item.best)
                        | !{item.title}
else
    p There are no items to display at this time.

if (data && data.widget && data.widget.moreUrl)
    div.top-list__footer
        a.more-link(href=data.widget.moreUrl)
            if (data && data.widget && data.widget.moreText)
                | !{data.widget.moreText}
            else
                | More