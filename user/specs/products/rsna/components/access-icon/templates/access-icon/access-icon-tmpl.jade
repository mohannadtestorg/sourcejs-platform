extends ../../../../../../ux3/components/access-icon/templates/access-icon/access-icon-tmpl

block topAccessIcon
    - accessValues = {"normal":{"text":"", "title":""},"full-access":{"text":"Full Access", "title":"This content is available for free"},"no-access":{"text":"No Access", "title":"You do not have access to the full text of this content"},"open-access":{"text":"Open Access", "title":"This content is available through an open access license"},"free":{"text":"Free Access", "title":"You have full access to this content"}}

block mainAccessIcon
    span.citation__top__item.article__access
        if(data)
            if(data.license && data.license.type)
                - currentAccess = accessValues[data.license.type]
                span.article__access__type(title=currentAccess.title)
                    if (data.license.type === "open-access")
                        i.citation__access__icon.icon-lock_open
                    if (data.license.type === "full-access")
                        i.citation__access__icon.icon-lock_open
                    if (data.license.type === "free")
                        i.citation__access__icon.icon-lock_open
                    if (data.license.type === "normal")
                        i.citation__access__icon.icon-Icon_Permissions-Locked
                    else if (data.license.type === "no-access")
                        i.citation__access__icon.icon-Icon_Permissions-Locked
                    span.citation__access__type !{currentAccess.text}