extends /specs/products/rsna/page-structure/structure/templates/structure/layout-tmpl.jade



block content

    section.source_section
        include /specs/page-structure/helpers/print-json-mixin.jade
        include /specs/page-structure/helpers/print-js-code-mixin.jade

        h2 Usage
        h3 Include template
        +printJsCode('include /specs/ux3/components/registration/templates/registration/registration-tmpl.jade')
        h3 Data
        markdown
            p The following data structure must exist to be able to use Registration template.
        +printJson({

        })

        markdown
            p You can add custom classes to the container elements by passing an array of additional class names in `"addClassNames": ["...", "..."]` field for these elements. If you need to replace the default class name, use `"useClassNames": ["...", "..."]` instead. See the table below for the list of container elements and their default class names.

            table
                thead
                    tr
                        th Container element
                        th Default class name
                        th Description
                tbody
                    tr
                        td `wrapper`
                        td form__registration
                        td Main component container

            p Use `headingLevel` parameter to set custom heading level for Registration form title. Default heading is `h2`.
    | #{''}

    section.source_section
        h2 Example
        +printJson({

        })
        each item, l in data.items
            h3!= item.title
            .source_example
                | !{item.body}
    | #{''}