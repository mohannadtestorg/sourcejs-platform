extends ../../../../../../ux3/components/teaser/templates/teaser/teaser-tmpl

block teaser
    div.creative-work
        .delayLoad
            if (item.best && item.image)
                a(href=item.best)
                    img(src=item.image)
            if (item.title)
                if (item.best)
                    a(href=item.best title=item.title)
                        h5.creative-work__title !{item.title}
                else
                    h5.creative-work__title !{item.title}

            if (item.text)
                p !{item.text}

            if (item.contribs)
                | !{item.contribs}
            +meta(item)

        +loading(image)

block meta
    if (item && item.epubDate)
        div.teaser__meta
            span.teaser__meta__date-label Date:
            span.teaser__meta__date-val
                | !{pb.render('date', {date: item.epubDate, format: 'dateMonthYearShort'})}
    if (item && item.editorial && item.editorial.length > 0)
        div.editorial
            strong.space-a !{editorialLabel}
            !{item.editorial[0].content[0].contribs}