{
    "title": "LOI page",
    "tag": ["templates"],
    "clearview": true,
    "templateData": {
        "header":{
            "$pug": {
                "template": "../header/templates/header/header-tmpl.jade",
                "data": {
                    "$ref": "../header/templates/data/header.json"
                }
            }
        },
        "breadcrumbs":{
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "true",
                            "className": ["hidden-sm","hidden-xs"]
                        },
                        "data": {
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/widgets/breadcrumbs/templates/breadcrumbs/breadcrumbs-tmpl.jade",
                                    "data": {
                                        "$ref": "../../widgets/breadcrumbs/templates/data/data.json"
                                    }
                                }
                            }
                        }
                    }

                }
            }
        },
        "loi":{
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "true",
                            "className": ["loi__banner"]
                        },
                        "data": {
                            "content": {
                                "$pug": {
                                    "template": "../../widgets/list-of-issues/templates/list-of-issues/list-of-issues-tmpl.jade",
                                    "data": {
                                        "$ref": "../../widgets/list-of-issues/templates/data/loi-decade.json"
                                    }
                                }
                            }
                        }
                    }

                }
            }
        },
        "Ad":{
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "false"
                        },
                        "data": {
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/widgets/html/templates/html/html-tmpl.jade",
                                    "data": {
                                        "thisWidget": {
                                            "properties": {
                                                "render": "html",
                                                "html": "<div class=\"pb-ad\"><a href=\"#\"><img src=\"/specs/products/rsna/images/ad.svg\"></a></div>"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                }
            }
        },
        "video":{
            "$pug": {
                "template": "../../../../ux3/widgets/shared-widget/templates/shared-widget/shared-widget-tmpl.jade",
                "data": {
                    "model": {
                        "config": {
                            "wrapper": "false"
                        },
                        "data": {
                            "content": {
                                "$pug": {
                                    "template": "../../../../ux3/widgets/html/templates/html/html-tmpl.jade",
                                    "data": {
                                        "thisWidget": {
                                            "properties": {
                                                "render": "html",
                                                "html": "<div class=\"podcasts-video\"><iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/0h5QfV0dJ8o\" frameborder=\"0\" gesture=\"media\" allow=\"encrypted-media\" allowfullscreen></iframe><span>Listen to our new Podcast on Radiology</span></div>"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                }
            }
        },
        "footer":{
            "$pug": {
                "template": "../footer/templates/footer/footer-tmpl.jade",
                "data": {
                    "$ref": "../footer/templates/data/footer.json"
                }
            }
