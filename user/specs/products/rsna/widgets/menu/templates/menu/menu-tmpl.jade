extends ../../../../../../ux3/widgets/menu/templates/menu/menu-tmpl

block mainNavArrows
    i.icon-arrow_r.pull-right(aria-hidden="true" class=viewPortInvertClass)
    i.icon-timeline_mark.pull-right(aria-hidden="true" class=viewPortClass)

block mainNavArrows2
    i.icon-arrow_r.pull-right(aria-hidden="true" class=viewPortInvertClass)
    i.icon-timeline_mark.pull-right(aria-hidden="true" class=viewPortClass)

block mainNavBlock
    div.res-menu-nav
        div.main-nav
            a(href="#" + data.id data-target=data.id data-toggle="nav" title="menu drawer")
                block navIcons
                    i.icon-menu2(aria-hidden="true")
                    i.icon-close_thin(aria-hidden="true")
            block mainNavContainer
                nav.drawer__nav.gutterless(role="navigation" id=data.id class=viewPortClass data-ctrl-res=viewPort)
                    a.menu-header(href='#' class=viewPortInvertClass) Home
                    +menu(data.list, false)

block MenuDropZone

block menuSuffix
    li.dropdown-more.hidden.dropdown.menu-parent(role='menuitem', aria-haspopup='true', aria-label='More')
        a.dropdown__toggle(href='#', title='More', data-toggle='dropdown')
            span More
            i.icon-timeline_mark.pull-right.hidden-sm.hidden-xs(aria-hidden='true')
        ul.rlist.dropdown__menu(aria-labelledby='main0-1', aria-hidden='true', role='menu')

