extends ../top-content/top-content-alt-tmpl

block topContentDropzone
    div.top-content-dropzone
        div.base.dropBlock.top-content__dropblock
            a.inline-icon(data-db-target-for="top-content-dropblock" data-db-switch="rotate")
                span Subspecialty
                i.icon-section_arrow_d(aria-hidden="true")
            a.icon-filter_list(data-slide-target=".top-content__dropblock__holder")

            div.dropBlock__holder.top-content__dropblock__holder(data-db-target-of="top-content-dropblock")
                ul.top-content__dropblock-list
                    li
                        a(href="#")
                            i.icon-Icon_Download
                            span Menu item
                    li
                        a(href="#")
                            i.icon-Icon_Star-26
                            span Menu item

