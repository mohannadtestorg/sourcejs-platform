

div.pagination

    if (data.prevButton) && (data.prevButton.itemUrl)
        a.pagination__btn--prev(href= data.prevButton.itemUrl, title='Previous Page')
    else
        span.pagination__btn--prev.disabled

    ul.rlist--inline.pagination__list
        each item, l in data.pager
            li
                if (item.active) && item.active == 'true'
                    a(href=item.itemUrl class="active" title=item.text) !{item.text}
                else
                    a(href=item.itemUrl title=item.text) !{item.text}

    if (data.nextButton) && (data.nextButton.itemUrl)
        a.pagination__btn--next(href=data.nextButton.itemUrl title='Next page')
    else
        span.pagination__btn--next.disabled
