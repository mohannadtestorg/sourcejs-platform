                            .news
                                | !{pb.render('top-content', 'teaser-home', 'teaser-home.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["grid-sm-2 grid-lg-2 featured"], "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "News"}}}})}
                            | !{pb.render('top-content', 'recommended.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["grid-sm-2"], "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "Recomended"}}}})}
                            | !{pb.render('top-content', 'recommended.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["grid-sm-2"], "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "Most cited"}}}})}
                            | !{pb.render('top-content', 'recommended.json', {"shared": {"model": {"config": {"wrapper": "true", "className": ["grid-sm-2"], "headingLevel": "h3", "headingClass": ["section__header border-bottom"]}, "data": {"title": "Most read"}}}})}


                        .col-lg-3.col-md-12.col-sm-12
