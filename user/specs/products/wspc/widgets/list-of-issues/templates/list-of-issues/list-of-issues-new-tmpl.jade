block loiPrefix
    - data.loi.thisWidget = thisWidget;
    - var order = "ascending";
    - if (data.order == "descending") order = "descending"

block loi
    if (data.ajaxRequest)
        | !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs", {originaldata: data})}
    else
        div.loi__banner
            div.loi-wrapper(data-widget-id=thisWidget.id data-order= order data-journal-doi= data.loi.journalDoi data-grouptype=data.loi.groupType )
                if (data.loi)
                    div(id=thisWidget.id data-grouptype=data.loi.groupType)
                        - var tabsData = {tabsData: data.loi};
                        block loitabs
                            | !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs", tabsData)}