extends ../../../../../../ux3/widgets/list-of-issues/templates/list-of-issues/list-of-issues-tmpl

block loi
    if (data.collapsible == false)
        div.loi-wrapper.uncollapsible(data-db-parent-of=thisWidget.id data-order= order data-journal-doi= data.loi.journalDoi )
            div.loi__banner
                div.dropBlock__holder.dropBlock-loi__holder(id=thisWidget.id data-grouptype=data.loi.groupType)
                    - var tabsData = {tabsData: data.loi, collapsible: data.collapsible};
                    block loitabsUncollapse
                        | !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs", tabsData)}
    else
        div.loi-wrapper(data-db-parent-of=thisWidget.id data-order= order)
            div.loi__banner.coolBar.stickybar
                .coolBar__wrapper.stickybar__wrapper
                    a.hidden-lg.loi-slide__ctrl.w-slide__btn(href="#" data-slide-target="#loi-banner")
                        i.icon-toc
                        span Journal

                    div.loi__banner-list
                        if (data.nav)
                            #loi-banner.hidden-md.hidden-sm.hidden-xs
                                each item, k in data.nav
                                    if k == 'archive'
                                        a.w-slide__btn(class='loi__' + k href=item.href title=item.label data-db-target-for=thisWidget.id data-slide-target= '#' + thisWidget.id data-slide-clone='self')
                                            if (item.label)
                                                | !{item.label}

                                    else if k == 'additionalLinksData'
                                        each link, l in item
                                            if link.enabled == 'on' && link.url
                                                a(class='loi__additionalLink' href=link.url title=link.label)
                                                    if (link.label)
                                                        | !{link.label}

                                    else if item.href
                                        a(class='loi__' + k href=item.href title=item.label)
                                            if (item.label)
                                                | !{item.label}

                        .loi__banner__right-side
                            block loiBannerSecond
                                | !{pb.renderDropzone(thisWidget, "coolbarDropZone")}

                    if (data.loi)
                        div.dropBlock__holder.dropBlock-loi__holder(id=thisWidget.id data-db-target-of=thisWidget.id data-grouptype=data.loi.groupType)
                            - var tabsData = {tabsData: data.loi};
                            block loitabs
                                | !{pb.render("list-of-issues", "list-of-issues/extended/ext-tabs", tabsData)}
