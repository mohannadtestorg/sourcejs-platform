include ../../../lazy-load/templates/lazy-load/lazy-load-tmpl.jade

- var image = 'false';



mixin teaser(item)
    - image = 'false';
    div.creative-work.left-side-image
        .delayLoad
            if (item.group && item.group.coverImage)
                - image = 'true';

                if (item.group && item.group.serial && item.group.serial.journalLink)
                    a(href=item.group.serial.journalLink title=item.title)
                        img.creative-work__img(src=item.group.coverImage.src alt=item.title title=item.title)
                else
                    img.creative-work__img(src=item.group.coverImage.src alt=item.title title=item.title)

            if (item.title)
                if (item.best)
                    a(href=item.best title=item.title)
                        h3.creative-work__title !{item.title}
                else
                    h3.creative-work__title !{item.title}

            if (item.contribs)
                | !{item.contribs}

            div.meta
                if (item) && (item.epubDate)
                    | !{pb.render('date', {date: item.epubDate, format: 'dateMonthYearShort'})} |

                if (item.group && item.group.serial && item.group.serial.title)
                    | #{' '}
                    if (item.group && item.group.serial && item.group.serial.journalLink)
                        a(href=item.group.serial.journalLink title=item.title)
                            | !{item.group.serial.title}
                        | #{' | '}
                    else
                        | !{item.group.serial.title} |

                if (item.group && item.group.citationLine)
                    | #{' '}
                    | !{item.group.citationLine}

        +loading(image)


mixin render(items)
    - var itemNo = items.length
    if itemNo > 1
        ul.rlist.lot
            each item, l in items
                li.grid-item
                    +teaser(item)
    else
        each item, l in items
            +teaser(item)

if (data) && (data.items)
    +render(data.items)
