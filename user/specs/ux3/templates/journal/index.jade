extends /specs/ux3/page-structure/structure/templates/structure/layout-tmpl.jade



block content

    h1 Journal Home page
    .source_info



    section.source_section
        h2 Journal Home page
        markdown
        .source_example
            | !{data.header}
            main.content.journal-home
                .meta-wrapper

                .container
                    | !{data.meta}
                    | !{data.loi}
                    .row.separator
                        .col-md-8.col-sm-7.gutterless
                            | !{data.articles}

                        .col-md-4.col-sm-5
