                            | !{data.nl}

                            //mpu ad
                            .mpu
                    .row.separator
                        .col-md-8.col-sm-7
                            | !{data.news}

                    .row.separator--extra

                        .col-md-8.col-sm-7.gutterless
                            | !{data.Recommended}
                            | !{data.cited}
                            | !{data.read}

                        .col-md-4.col-sm-5
                            | !{data.tweets}

            | !{data.footer}
    | #{''}