h3.profile__heading.border-bottom Professional information

block profInfoContent
    .row
        .col-md-10
            form
                .grid-md-2.row
                    .grid-item
                        label Disipline
                        select.jcf
                            option Lorem
                            option Ipsum
                            option Dolor

                    .grid-item
                        label Specialization
                        select.jcf
                            option Lorem
                            option Ipsum
                            option Dolor

                label(for='organization') Organization
                input(id="organization" type="text" placeholder="Type your organization")

                label(for='position') Position
                input(id="position" type="text" placeholder="Type your position")

                button.btn.profile-dark__btn  Save
                a(href="#").my-account__cancle Cancle
