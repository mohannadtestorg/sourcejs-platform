extends /specs/ux3/page-structure/structure/templates/structure/layout-tmpl.jade

block content

    h1 Review Submission Page



    section.source_section
        h2 Review Submission
        markdown
        code.src-html
        .source_example
            | !{data.header}

            main.content.content__submission.readonly
                .container
                    h1 Review Submission
                    .draft-form
                        h4.border-bottom Submission Info
                        form#draftForm.uploader-form(method="post", enctype="multipart/form-data")
                            input(type="hidden", name="doi", value=data.doi)
                            input(type="hidden", name="index", value=data.index)
                            input(type="hidden", name="anti-forgery-token", value=data.csrfToken)

                            .row
                                .col-md-8.gutterless
                                    .col-md-12
                                        | !{data.basicMetadata}
                                        | !{data.category}
                                        | !{data.categories}


                            .row
                                .col-md-12
                                    | !{data.tableAuthors}


                            .row
                                .col-md-12
                                      | !{data.tableFunders}


                            .row
                                .col-md-12
                                    | !{data.pdfUploader}

                            .row
                                .col-md-12
                                    
                                    | !{data.tableFiles}


                            .row
                                .col-md-12

                                    | !{data.tableLinks}




                            .row
                                .col-md-12
                                    hr.separator.clearfix
                                    .actions.pull-right
                                        a(href="#").btn--cancel Cancel
                                        a(href="#").btn--submit.button Back to Edit
                                        a(href="#").btn--submit.button Submit





            | !{data.footer}
    | #{''}

