#6ad59e50-34c2-447e-91a5-307031e8d9e5.widget.eCommerceCheckoutBuyingItemsWidget.none.widget-none.widget-compact-horizontal
    .wrapped
        .widget-body.body.body-none.body-compact-horizontal
            .header.commerce-header
                | Buying items
            #buytabcontent.tabContent.active
                .buyingList-info.hidden(data-notification='info')
                    p
                // if there is no items in the evaluated quotes then show empty buying list message
                .articleDataContainer
                    br
                    .articleTitlePrice
                        p.float-left.boldText
                            | ASCE Library Card (5 downloads)
                            br
                            br
                            a(href='http://ascelibrary.org/doi/10.1061/%28ASCE%29AS.1943-5525.0000731')
                                | Vortex Formation during Draining from Cylindrical Tanks: Effect of Drain Port Eccentricity
                        .float-right.item-price
                            | $85.00
                    .tabPanelFooter
                        a(data-bind='saveItem', data-item-id='INV|LC5|LC5-ELECTRONIC-USD-10.1061/(ASCE)AS.1943-5525.0000731-6275', href='/action/saveItem?id=INV|LC5|LC5-ELECTRONIC-USD-10.1061/(ASCE)AS.1943-5525.0000731-6275')
                            | Save for later
                        a(data-bind='removeItem', data-item-id='INV|LC5|LC5-ELECTRONIC-USD-10.1061/(ASCE)AS.1943-5525.0000731-6275', href='/action/removeCartItem?id=INV|LC5|LC5-ELECTRONIC-USD-10.1061/(ASCE)AS.1943-5525.0000731-6275')
                            | Remove
                .buyItemFooter
                    .promoCodeBlock(style='width: 100%;')
                        .promoCodeForm
                            form#applyDiscountForm(action='/action/applyDiscount', method='post')
                                input.clearableInput(title='Add discount code', type='text', name='discount', value='', size='15', placeholder='Add discount code')
                                input.button.applyDiscount.float-right-xs-sm(data-bind='applyDiscount', type='submit', title='Apply', value='Apply', disabled='')
                            .promoCodeMsg.visible-md.visible-lg
                                span.errorMsg.hidden
                                span.infoMsg.hidden
                        .promoOffers.hidden
                    p.totalPrice
                        | Subtotal:
                        span.boldText
                            | $85.00
                    p.intialPrice
                        | Initial price: $85.00