mixin prev(link)
    a.content-navigation__btn--pre(href=link title="Previous")
        block previousCaption
            i.icon-arrow_l
            span Previous

mixin next(link)
    a.content-navigation__btn--next(href=link title="Next")
        block nextCaption
            span Next
            i.icon-arrow_r

div.content-navigation.clearfix
    if (data.content.previous)
        case data.content.type
            when "Article"
            when "Chapter"
            when "Digital Object Pub"
                +prev(data.content.previous.itemUrl)
            when "Issue"
                +prev(data.content.previous.tocUrl)
            when "Book"
                +prev(data.content.previous.bookUrl)

    block contentNavigationDropZone
        div.content-navigation__extra
            | !{pb.renderDropzone(thisWidget, "navigation-dropzone")}

    if (data.content.next)
        case data.content.type
            when "Article"
            when "Chapter"
            when "Digital Object Pub"
                +next(data.content.next.itemUrl)
            when "Issue"
                +next(data.content.next.tocUrl)
            when "Book"
                +next(data.content.next.bookUrl)