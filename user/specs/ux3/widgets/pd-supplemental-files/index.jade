extends /specs/ux3/page-structure/structure/templates/structure/layout-tmpl.jade


block content
    section.source_section

        include ../../../page-structure/helpers/print-json-mixin.jade
        include ../../../page-structure/helpers/print-template-include-mixin.jade
        include ../../../page-structure/helpers/print-js-code-mixin.jade

        h2 Usage
        h3 Data
        markdown
            p The following data structure must exist to be able to use supplemental-files widget.

        +printJson({
            "data": {

                "uploadLink": "/uploadepdfFile",
                "doi": "https://doi.org/10.1377/hlthaff.2017.0945",
                "csrfToken": "123456789",
                "signature": "11223365",
                "forms": [
                    {
                        "label": {
                            "value": "Table of temperature density distribution in last decade",
                            "message": {}
                        },
                        "fileName": {
                            "value": "parse.csv",
                            "message": {}
                        }
                        ,
                        "type": {
                            "value": "",
                            "message": {}
                        }

                    },
                    {
                        "label": {
                            "value": "Generic representation of soil formation in volcanic areas",
                            "message": {}
                        },
                        "fileName": {
                            "value": "Soil_Volcanic.png",
                            "message": {}
                        }
                        ,
                        "type": {
                            "value": "",
                            "message": {}
                        }
                    }
                ]
            }
        })

    | #{''}

    section.source_section
        h2 Examples

        h3!= data.items[0].title
        .source_example
            | !{data.items[0].body}

        h3!= data.items[1].title
        .source_example

            | !{data.items[1].body}


    | #{''}