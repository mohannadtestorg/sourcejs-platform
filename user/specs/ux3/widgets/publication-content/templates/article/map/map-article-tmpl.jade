mixin articleCitation()
    block articleCitation

        if(data.item && data.item.titles && data.item.formats)
            -
                var citationData = {
                "itemUrl": data.item.formats.fullText,
                "title": data.item.titles.primary,
                "authors": data.item.contribsShort,
                }
            //| !{pb.render("publication-content", "article/extended/ext-citation", {data: citationData})}

