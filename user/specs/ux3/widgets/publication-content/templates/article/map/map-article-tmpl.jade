mixin articleBody()
    block articleBodyClasses
        -var articleBodyClasses='article__body'
    block articleBody
        -var showRefOfArticleBodyClass=""
        if(data.item && data.item.serviceName && data.item.serviceName == "showEnhancedAbstract")
            -showRefOfArticleBodyClass="show-references"

        div(class=articleBodyClasses + " " +showRefOfArticleBodyClass)
            if (data.item && data.item.supplHtml) && data.item.supplHtml != ''
                h2(class="article-section__title section__title" id="secSuppl") Supplemental Material
                | !{data.item.supplHtml}

            else if (data.item && data.item.supplContentList) && data.item.supplContentList != ''
                .article-section__content
                    h2(class="article-section__title section__title" id="secSuppl") Supplemental Material

                    each suppl in data.item.supplContentList
                        p
                            if(suppl.url && suppl.fileName)
                                a(href=suppl.url)= suppl.fileName
                                if (suppl.supplSize) && suppl.supplSize != ''
                                    | &nbsp;(!{suppl.supplSize})

            else if(data.item)
                | !{data.item.htmlContent}
            block articleContentSuffix

        if (toolbox)
            | !{toolBox}