.request-reset(widget-def='requestResetPasswordWidget', widget-id='88c6da25-5f6d-4d3f-a17e-73de1a0933eb')
    p Can't sign in? Forgot your password?
    p.sub Enter your email address below and we will send you the reset instructions
    .message.error
    form.request-reset-password-form(action='/action/requestResetPassword', method='post')
        input(type='hidden', name='requestResetPassword', value='true')
        .input-group
            .label
                label(for='88c6da25-5f6d-4d3f-a17e-73de1a0933eb.email') Email
            input.email(id='88c6da25-5f6d-4d3f-a17e-73de1a0933eb.email', type='text', name='email', value='', size='15')
        script(src='//www.google.com/recaptcha/api.js?render=explicit&onload=loadRecaptcha', async='', defer='')
        .g-recaptcha(data-sitekey='6Lc4HR8TAAAAAPFSxfchztMruqn2dTwPIQ9vaX9b')
        input.button.primary.submit(type='submit', name='submit', value='Submit', disabled='disabled')
