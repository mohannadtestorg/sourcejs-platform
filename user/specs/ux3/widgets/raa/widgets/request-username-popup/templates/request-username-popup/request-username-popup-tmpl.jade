.popup.username-popup.hidden
    a.close(href='#')
        i.icon-close_thin
    .content
        h2 Request Username
        .form
            p Can't sign in? Forgot your username?
            p.sub Enter your email address below and we will send you your username
            .message.error
            form(action='/action/requestUsername', method='post')
                input(type='hidden', name='requestUsername', value='requestUsername')
                .input-group
                    .label
                        label(for='0400daa0-d6db-4395-91d5-1fac4b5c6d78.email') Email
                    input.email(id='0400daa0-d6db-4395-91d5-1fac4b5c6d78.email', type='text', name='email', value='', size='15')
                script(src='//www.google.com/recaptcha/api.js?render=explicit&onload=loadRecaptcha', async='', defer='')
                .g-recaptcha.explicit(data-sitekey='6Lc4HR8TAAAAAPFSxfchztMruqn2dTwPIQ9vaX9b')
                input.button.primary.submit(type='submit', name='submit', value='Submit', disabled='disabled')
        .success-template.hidden.note
            p
                | If the address matches an existing account you will receive an email with instructions to retrieve your username
