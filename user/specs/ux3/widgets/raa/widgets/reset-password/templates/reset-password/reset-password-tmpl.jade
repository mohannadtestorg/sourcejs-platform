.reset-password.resetPasswordWidget(widget-def='resetPasswordWidget', widget-id='375dda78-c865-4bce-870c-427c64f94544')
    form(action='https://annualreviews.org/action/resetPassword', method='POST')
        p.note
            | To reset your password, enter a
            span.bold New Password
            |  and click the
            span.bold Reset
            |  button.
        input(type='hidden', name='userId', value='')
        input(type='hidden', name='email', value='')
        input(type='hidden', name='expiry', value='')
        input(type='hidden', name='signature', value='')
        input(type='hidden', name='resetPassword', value='resetPassword')
        .input-group
            .label
                label(for='375dda78-c865-4bce-870c-427c64f94544-password1') New Password
            input#375dda78-c865-4bce-870c-427c64f94544-password1.pass-hint.password(type='password', name='password1', value='', autocomplete='off')
            span.password-eye-icon.icon-eye.hidden
            .password-strength-indicator(data-min='6', data-max='50', data-strength='3')
                span.text.too-short Too Short
                span.text.weak Weak
                span.text.medium Medium
                span.text.strong Strong
                span.text.very-strong Very Strong
                span.text.too-long Too Long
        input.button.primary.submit(type='submit', value='Reset', disabled='disabled')
