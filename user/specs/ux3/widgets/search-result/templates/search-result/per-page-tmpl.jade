if(data.perPageLinks)
    div.per-page.separator-end
        span.per-page__label per page:
        ul.rlist--inline

            li
                - var classes = ""
                if data.search && data.search.pageSize == 20
                    - classes = "js--selected"
                a(href= data.perPageLinks.pageSize20 class= classes) 20

            li
                - var classes = ""
                if data.search && data.search.pageSize == 50
                    - classes = "js--selected"
                a(href= data.perPageLinks.pageSize50 class= classes) 50

            li
                - var classes = ""
                if data.search && data.search.pageSize == 100
                    - classes = "js--selected"
                a(href=data.perPageLinks.pageSize100 class= classes) 100
