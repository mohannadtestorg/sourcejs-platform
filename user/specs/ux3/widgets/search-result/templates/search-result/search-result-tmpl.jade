block searchResultPrefix

mixin defineUserLayout
    block defineUserLayout
        if(data.widgetData.groupTabs)
            -var bookTab= data.widgetData.groupTabs.journalTitle;
            if(bookTab)
                if(bookTab.active == "true")
                    -searchlistClass="search-result__books "
                if(bookTab.active == "true" && bookTab.userDefinedLayout == "true")
                    -showLayoutIcons=true;
                    if(bookTab.layout == "tile")
                        -searchlistClass=searchlistClass + "search-result--tile";
                        -isTileLayoutActive=true;


-var searchlistClass="";
-var showLayoutIcons=false;
-var isTileLayoutActive=false;
+defineUserLayout


if(data.search)
    block searchPages
        - var pages = data.search.hitsLength / data.search.pageSize

    - var rest = data.search.hitsLength % data.search.pageSize
    if rest > 0
        - pages++
    - var resultFrom = 1 + (data.search.startPage) * (data.search.pageSize)
    - var resultTo = data.search.hitsLength < data.search.pageSize ? data.search.hitsLength : resultFrom + data.search.pageSize -1
    - resultTo = resultTo > data.search.hitsLength ? data.search.hitsLength : resultTo
    - var classes = "search-result"

    block alertsFreq
        - var alertTimes = {alerts: ['Never', 'Daily', 'Weekly', 'Monthly']};
        - var alertDefaultValue = 'Never';

mixin saveSearchDialog()
    block saveSearchDialog
        .ux-modal-container.search__modal
            #saveSearchDialog.modal(role="dialog")
                .modal__dialog
                    .modal__header
                        button.close(type='button', data-dismiss='modal')
                            i.icon-close_thin(aria-hidden='true')
                        h2 Save this search
                    .modal__body
                        if data.isLoggedIn
                            form(action='/action/doSaveSearch', name='frmSaveSearch', method='post')
                                if(data.saveSearchParams)
                                    each item,i  in data.saveSearchParams
                                        each value,i  in item.value
                                            input(type='hidden', name=item.name, value= value)
                                input(type='hidden', name='perform', value='save')
                                input(type='hidden', name='ajax', value='true')
                                input(type='hidden', name='dispSavedSearches', value='true')
                                .input-group
                                    label.hidden(for='SSName') Name:
                                    input.search-term(autofocus='true', type='text', name='saveSearchName', value='', size='15', placeholder=' Enter search name')
                                block alertsFreqMessage
                                    h4 Alert me to new results:
                                .input-group
                                    if(alertTimes && alertTimes.alerts)
                                        each alertTime, l in alertTimes.alerts
                                            label
                                                input(type='radio', name='alertme', value=alertTime, checked= alertTime == alertDefaultValue ? true : false)
                                                span.label-txt !{alertTime}

                                .saveSearchProgress
                                input#newSearchSaveButton.button.primary(type='submit', name='submit', value='Save search')

                        else
                            p  Please &nbsp;
                                a(href="/action/showLogin?uri=" + data.searchParams) login
                                |  to be able to save your searches and receive alerts for new content matching your search criteria.

div(class= "search-result " + data.serviceName)
    block searchResultTop
        if (data.widgetData && data.widgetData.groupTabs && data.serviceName == "doSearch")
            | !{pb.render("search-result", "search-result/search-tabs", {data: data, thisWidget: thisWidget})}

        div.search-result__follow.clearfix
            if (data.serviceName == "doSearch")
                div.pull-left.search__result.search__result--space
                    if data.search.hitsLength > 0
                        span.result__current Results:
                            span  !{resultFrom} - !{resultTo}
                        span.result__sep of
                        if(data.search)
                            span.result__count !{data.search.hitsLength}
                        block resultSuffix
                            if(data.widgetData && data.widgetData.refineSearch && data.widgetData.refineSearch.searchIn && data.widgetData.refineSearch.searchIn.length && data.widgetData.refineSearch.searchIn[0].searchTerm)
                                span.result__suffix !{data.widgetData.refineSearch.searchIn[0].searchTerm}
                    else
                        span.result__current Results:
                            span  0 - 0
                        span.result__sep of
                        span.result__count 0

                div.pull-right.search__follow
                    block searchResultFollowLabel
                        span.search__follow__label Follow results:
                    .search__follow__item
                        a#saveSearchTriggerButton.search__follow__icon(href='#saveSearchDialog', role='button', data-toggle='modal', data-target='#saveSearchDialog', aria-label='Click here to save your search', title='Save Search')
                            i.icon-save-search(aria-hidden="true")

                        span.hidden.error.saveSearchMsg
                            | Failed to save your search, try again later
                        span.hidden.success.saveSearchMsg
                            | Search has been saved
                            a(href='/search/saved')  (Edit)

                    block searchResultRss
                        .search__follow__item
                            if(data.search && data.search.searchFeed && data.search.searchFeed.linkHref)
                                a.search__follow__icon(href=data.search.searchFeed.linkHref title=data.search.searchFeed.linkTitle name="RSSFeed" class="RSS controlLinks" role="button")
                                    i.icon-Rss(aria-hidden="true")

                +saveSearchDialog()

    block searchResultTopShowPublications
        div.search-result__meta
            div.search-result__meta__top.clearfix
                div.pull-left.search__result
                    if (data.serviceName == "showPublications")
                        if data.search && data.search.hitsLength > 0
                            span.result__current Results: !{resultFrom} - !{resultTo}
                            span.result__sep of
                            span.result__count !{data.search.hitsLength}
                        else
                            span.result__current Results: 0 - 0
                            span.result__sep of
                            span.result__count 0
                        a(href="#" class="visible-xs visible-sm pull-right w-slide__btn result__ctrl__filters" data-slide-target="#filter")
                            i(class="icon-filter_list inline-icon" aria-hidden="true")
                            span Filters
                    else
                        block refineSearch
                            a.search-result__refine.advanced-search__ctrl.w-slide__btn(href="#" data-slide-target="#advancedSearch" )
                                span refine search
                                i(class="icon-section_arrow_d" aria-hidden="true")
                div.pull-right.search__bottom.clearfix
                    if (data.serviceName == "doSearch")
                        block searchFiltersOpen
                            a(href = "#" class="visible-xs visible-sm pull-right w-slide__btn result__ctrl__filters" data-slide-target="#filter")
                                i(class="icon-filter_list inline-icon" aria-hidden="true")
                                span Filters
                    //- check if we have result
                    if data.search && data.search.hitsLength > 0
                        | !{pb.render("search-result", "search-result/per-page", {data: data, thisWidget: thisWidget})}
                    if (data.widgetData && data.widgetData.sortLinks)
                        | !{pb.render("search-result", "search-result/sort-options", {data: data, thisWidget: thisWidget})}

                    block extraLinks
                        if(showLayoutIcons == true)
                            div.search__layout
                                span.search__layout-list(class=(isTileLayoutActive ? "" : "active"))
                                    i.icon-toc
                                span.search__layout-tile(class=(isTileLayoutActive ? "active" : ""))
                                   block tileIcon
                                      i.icon-four-grid-layout

            if (data.serviceName == "doSearch")
                block advancedSearch
                    div.advanced-search__tabs#advancedSearch
                        | !{pb.render("search-result", "search-result/extended/ext-tabs", {data: data, thisWidget: thisWidget})}




    block searchResultMain
        block searchListClasses
            -var listClasses=searchlistClass;
        if(data.search)
            - var itemNo = data.search.dataLength
        if itemNo > 0
            if data.widgetData && data.widgetData.useXSLT
                block resultsListClassesXSLT
                    - var ulClasses = "rlist search-result__body items-results " +listClasses
                ul(class = ulClasses)
                    | !{data.search.xslt}
            else
                block searchResultMainItemsJade
                    block resultsListClasses
                        - var ulClasses = listClasses + " rlist search-result__body titles-results "
                    ul(class = ulClasses)
                        if(data.search && data.search.results)
                            each item, i in data.search.results
                                block searchResultDropZone
                                    include ./search-drop-zone-tmpl
                                - var url = "#"
                                if(item.content)
                                    if (item.content.journalUrl)
                                        - url = item.content.journalUrl
                                    if (item.content.bookUrl)
                                        - url = item.content.bookUrl
                                    if (item.content.bestUrl)
                                        - url = item.content.bestUrl
                                li.clearfix.separator.search__item
                                    - I++
                                    block searchItemCoverImage
                                        if (item.type == "105") || (item.type == "102")
                                            if(item.content)
                                                    if (item.content.coverImage)
                                                        div.item__image
                                                            a(href=url title="go to " + item.content.title)
                                                                img(src=item.content.coverImage.src title="cover Image of " + item.content.title )
                                                    else if (item.content.latestIssue && item.content.latestIssue.coverImage)
                                                        div.item__image
                                                            a(href=url title="go to " + item.content.title)
                                                                img(src=item.content.latestIssue.coverImage.src title="cover Image of " + item.content.title )
                                                    else
                                                        block searchItemDefaultCoverImage
                                                            div.item__image
                                                                a(href=url title="go to " + item.content.title)
                                                                    div.item__default__image
                                                                        i.item__default__icon.icon-sort(aria-hidden="true")
                                        if (item.type == "106")
                                            if(item.content)
                                                div.item__image
                                                    a(href=url title="go to " + item.content.title)
                                                        if (item.content.latestBook && item.content.latestBook.coverImage)
                                                                img(src=item.content.latestBook.coverImage.src title="cover Image of " + item.content.title )
                                                        else
                                                                div.item__default__image
                                                                    i.item__default__icon.icon-sort(aria-hidden="true")

                                    div.item__body.clearfix
                                        if (item.type) || (item.content.access)
                                            div.meta__header
                                                block SearchItemMetaType
                                                    span.meta__type
                                                        if (item.type == "102")
                                                            | Journal
                                                        if (item.type == "103")
                                                            | Article
                                                        if (item.type == "105")
                                                            | Book
                                                        if (item.type == "106")
                                                            | Book  Series
                                                        if (item.type == "109")
                                                            | Chapter
                                                block access
                                                    if(data.widgetData && data.widgetData.displayAccessIcon)
                                                        span.meta__access
                                                            if item.content.access == "full" && data.widgetData.displayAccessIcon.displayFullAccess == true
                                                                i.icon-lock_open
                                                                span Full Access
                                                            if item.content.access == "free" && data.widgetData.displayAccessIcon.displayFreeAccess == true
                                                                i.icon-lock_open
                                                                span Free Access
                                                            if item.content.access == "open" && data.widgetData.displayAccessIcon.displayOpenAccess == true
                                                                i.icon-lock_open
                                                                span Open Access
                                                            if item.content.access == "no" && data.widgetData.displayAccessIcon.displayNoAccess == true
                                                                i.icon-lock_outline
                                                                span No Access
                                        block searchItemFullInfo
                                            block searchItemTitle
                                                h4.meta__title.meta__title__margin
                                                    if(item.content)
                                                        if (item.type == "102")
                                                            a(href= item.content.journalUrl) !{item.content.title}
                                                        if (item.type == "103")
                                                            a(href= item.content.bestUrl) !{item.content.title}
                                                        if (item.type == "105")
                                                            a(href= item.content.bookUrl) !{item.content.title}
                                                        if (item.type == "106")
                                                            a(href= item.content.bookSeriesUrl) !{item.content.title}
                                                        if (item.type == "109")
                                                            a(href= item.content.bestUrl) !{item.content.title}

                                            block searchItemInfo
                                                if(item.content)
                                                    div.meta__info
                                                        | !{item.content.contribs}
                                                        block searchMeta
                                                            div.meta__details
                                                                if (item.content.type == "Journal")
                                                                  block currentIssueTitle
                                                                     | Current Issue:&nbsp;
                                                                if (item.content.latestIssue)
                                                                    if (item.content.latestIssue.volume && item.content.latestIssue.issue && item.content.latestIssue.volume)
                                                                        a.meta__vol(href=item.content.latestIssue.tocUrl) Volume !{item.content.latestIssue.volume}, Issue !{item.content.latestIssue.issue}
                                                                    if (item.content.latestIssue.coverDate && item.content.latestIssue.tocUrl)
                                                                        a.meta__date(href= item.content.latestIssue.tocUrl) !{item.content.latestIssue.coverDate}
                                                                if (item.content.coverDate)
                                                                    span.meta__date !{item.content.coverDate}
                                                                if (item.content.edition)
                                                                    span.meta__edition !{item.content.edition}
                                                                if (item.content.epubDate)
                                                                    span.meta__epubDate !{item.content.epubDate}
                                                                if (item.content.group)
                                                                    if (item.content.group.volume && item.content.group.issue)
                                                                        a.meta__volume(href= item.content.group.tocUrl) Volume !{item.content.group.volume}, Issue !{item.content.group.issue}
                                                                    if (item.content.group.serial)
                                                                        a.meta__serial(href= item.content.group.serial.journalUrl) !{item.content.group.serial.title}
                                                                    block searchMetaTitle
                                                                        if (item.content.group.title)
                                                                            a.meta__title(href= item.content.group.bookLink) !{item.content.group.title}
                                                                    if (item.content.group.coverDate)
                                                                        a.meta__coverDate(href= item.content.group.bookLink) !{item.content.group.coverDate}
                                                        block itemNumbers
                                                            if (item.content.issn)
                                                                div.meta__issns ISSN: !{item.content.issn}
                                                            if (item.content.eissn)
                                                                div.meta__eissn EISSN: !{item.content.eissn}
                                                            if (item.content.eisbn)
                                                                div.meta__eisbn EISBN:  !{item.content.eisbn}
                                                        block searchItemViews

                                                        if (item.content.abstract)
                                                            div.accordion
                                                                block searchItemAbstractLabel
                                                                    a(href="#" class="accordion__control" title="show Abstract")
                                                                        span Abstract
                                                                        i.icon-section_arrow_d(aria-hidden="true")
                                                                div.accordion__content !{item.content.abstract}
                                                        if (item.content.description)
                                                            div.accordion
                                                                block searchItemDescLabel
                                                                    a(href="#" class="accordion__control" title="show Aim & scope")
                                                                        span Aim & scope
                                                                        i.icon-section_arrow_d(aria-hidden="true")
                                                                div.accordion__content !{item.content.description}
                                                        block aboutBookWrapper

        else
            div.search-result__no-result
                if(data.widgetData)
                    | !{data.widgetData.textForNoResults}

    block searchResultPager
        include ./pager-tmpl