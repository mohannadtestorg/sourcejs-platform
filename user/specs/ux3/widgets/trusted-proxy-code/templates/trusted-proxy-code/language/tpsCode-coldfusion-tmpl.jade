    | &lt;!--- ask #{data.product} for permission and parameters and capture return---&gt;
    | &lt;cfhttp URL="http://#{data.wwwhost}/tps/requestticket?ru=#{data.formFields.journalUrl}&amp;debug=true&amp;domain=#{data.formFields.domain}" method="GET"&gt;
    | &lt;/cfhttp&gt;
    | &lt;cfif cfhttp.statusCode contains "200 OK"&gt;
    |    &lt;cflocation url="#cfhttp.filecontent#"&gt;  &lt;!--- redirect user to the content of the above request ---&gt;
    | &lt;/cfif&gt;
